        {
          "title": "\u0631\u0648\u0633\u062a\u0627\u06cc \u063a\u0631\u0642\u200c\u0634\u062f\u0647 \u062f\u0631 \u0647\u0646\u062f \u0686\u0647 \u0627\u0631\u062a\u0628\u0627\u0637\u06cc \u0628\u0627 \u0627\u0644\u0645\u0627\u0633 \u06a9\u0648\u0647 \u0646\u0648\u0631 \u062f\u0627\u0631\u062f\u061f",
