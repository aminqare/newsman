          "title": "\ud83d\udd34 \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e: \u062a\u0644\u0627\u0634 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u06cc\u0636\u0627\u062d \u0647\u06af\u0633\u062a \u0645\u0641\u062a\u0636\u062d\u0627\u0646\u0647 \u0634\u06a9\u0633\u062a \u062e\u0648\u0631\u062f\u061b \u0646\u062e\u0633\u062a \u0648\u0632\u06cc\u0631 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644: \u062a\u0646\u0647\u0627 \u0631\u0627\u0647 \u067e\u0627\u06cc\u0627\u0646 \u062f\u0627\u0626\u0645\u06cc \u062a\u0647\u062f\u06cc\u062f \u0627\u062a\u0645\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0633\u0631\u0646\u06af\u0648\u0646\u06cc \u0622\u0646 \u0627\u0633\u062a",
