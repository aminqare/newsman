          "title": "\ud83d\udd34 \u0646\u062e\u0633\u062a \u0648\u0632\u06cc\u0631 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644: \u062a\u0646\u0647\u0627 \u0631\u0627\u0647 \u067e\u0627\u06cc\u0627\u0646 \u062f\u0627\u0626\u0645\u06cc \u062a\u0647\u062f\u06cc\u062f \u0627\u062a\u0645\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0633\u0631\u0646\u06af\u0648\u0646\u06cc \u0622\u0646 \u0627\u0633\u062a",
          "link": "https://ir.voanews.com/a/8219967.html",
          "summary": "\u0628\u0646\u06cc\u0627\u0645\u06cc\u0646 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648\u060c \u0646\u062e\u0633\u062a\u200c \u0648\u0632\u06cc\u0631 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644\u060c \u0631\u0648\u0632 \u0633\u0647\u200c\u0634\u0646\u0628\u0647 \u06f1\u06f9 \u0622\u0628\u0627\u0646 \u0647\u0634\u062f\u0627\u0631 \u062f\u0627\u062f \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u062a\u0644\u0627\u0634 \u0628\u0631\u0627\u06cc \u0627\u062d\u06cc\u0627\u06cc \u062a\u0648\u0627\u0646 \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062e\u0648\u062f \u0627\u0633\u062a\u060c \u0648 \u06af\u0641\u062a \u062a\u0646\u0647\u0627 \u0631\u0627\u0647 \u0631\u0641\u0639 \u062f\u0627\u0626\u0645\u06cc \u0627\u06cc\u0646 \u062a\u0647\u062f\u06cc\u062f \u0633\u0631\u0646\u06af\u0648\u0646\u06cc \u0631\u0698\u06cc\u0645 \u0627\u0633\u062a. \u0627\u0648 \u062f\u0631 \u0622\u063a\u0627\u0632 \u0628\u06cc\u0633\u062a\u200c\u0648\u0634\u0634\u0645\u06cc\u0646 \u062f\u0648\u0631\u0647 \u06a9\u0646\u0633\u062a \u06af\u0641\u062a: \u00ab\u062a\u0646\u0647\u0627\u2026",
