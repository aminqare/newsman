          "summary": "\u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u06f2\u06f8 \u0645\u062a\u062d\u062f\u0634 \u0627\u0632 \u062c\u0645\u0644\u0647 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627\u060c \u0622\u0644\u0645\u0627\u0646\u060c \u0641\u0631\u0627\u0646\u0633\u0647 \u060c \u0627\u0633\u062a\u0631\u0627\u0644\u06cc\u0627 \u0648 \u06a9\u0627\u0646\u0627\u062f\u0627 \u0628\u0647 \u0627\u06cc\u0631\u0627\u0646 \u062f\u0631\u0628\u0627\u0631\u0647 \u00ab\u0627\u0642\u062f\u0627\u0645\u0627\u062a \u062e\u0635\u0645\u0627\u0646\u0647 \u062a\u0647\u0631\u0627\u0646 \u062f\u0631 \u0642\u0644\u0645\u0631\u0648\u0634\u0627\u0646\u00bb \u0647\u0634\u062f\u0627\u0631 \u062f\u0627\u062f\u0646\u062f. \u0628\u0627 \u062a\u062f\u0627\u0648\u0645 \u062d\u0645\u0644\u0627\u062a \u062d\u0648\u062b\u06cc\u200c\u0647\u0627 \u0628\u0647 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc\u060c \u067e\u0631\u0648\u0627\u0632\u0647\u0627 \u0628\u0647 \u062f\u0627\u062e\u0644 \u0648 \u062e\u0627\u0631\u062c \u0627\u0632 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u0628\u2026",
