        {
          "title": "\u0642\u0648\u0647 \u0642\u0636\u0627\u0626\u06cc\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0632 \u0627\u0639\u062f\u0627\u0645 \u0645\u062c\u06cc\u062f \u0622\u062f\u06cc\u0646\u0647\u060c \u0627\u0632 \u0645\u0639\u062a\u0631\u0636\u0627\u0646 \u062f\u06cc\u200c\u0645\u0627\u0647\u200c\u060c \u062e\u0628\u0631 \u062f\u0627\u062f",
