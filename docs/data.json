        {
          "title": "\u0637\u0631\u062d \u0627\u0633\u062a\u06cc\u0636\u0627\u062d \u0648\u0632\u06cc\u0631 \u062f\u0641\u0627\u0639 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0627\u0632 \u062c\u0645\u0644\u0647 \u062f\u0631 \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627  \u062d\u0645\u0644\u0647 \u0628\u0647 \u0645\u062f\u0631\u0633\u0647 \u0645\u06cc\u0646\u0627\u0628\u060c \u0628\u0647 \u0645\u062c\u0644\u0633 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u0627\u0646 \u0627\u0631\u0627\u0626\u0647 \u0634\u062f",
          "link": "https://www.bbc.com/persian/articles/cm4g1gq88074o?at_medium=RSS&at_campaign=rss",
          "summary": "\u0637\u0631\u062d \u0627\u0633\u062a\u06cc\u0636\u0627\u062d \u067e\u06cc\u062a \u0647\u06af\u0633\u062a\u060c \u0648\u0632\u06cc\u0631 \u062f\u0641\u0627\u0639 \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0628\u0647 \u0645\u062c\u0644\u0633 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u0627\u0646 \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631 \u0627\u0631\u0627\u0626\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u062a\u0648\u0645\u0627\u0633 \u0645\u0633\u06cc\u060c \u0646\u0645\u0627\u06cc\u0646\u062f\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc\u200c\u062e\u0648\u0627\u0647 \u0645\u062c\u0644\u0633 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u0627\u0646 \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0627\u06cc\u0646 \u0637\u0631\u062d \u0631\u0627 \u062f\u0627\u062f\u0647 \u0627\u0633\u062a. \u0627\u0631\u0627\u0626\u0647 \u0627\u06cc\u0646 \u0637\u0631\u062d \u0628\u0647 \u0645\u0639\u0646\u0627\u06cc \u062a\u0635\u0648\u06cc\u0628 \u0627\u0633\u062a\u06cc\u0636\u0627\u062d \u06cc\u0627 \u0628\u0631\u06a9\u0646\u0627\u0631\u06cc \u0648\u0632\u06cc\u0631 \u062f\u0641\u0627\u0639 \u0646\u06cc\u0633\u062a\u2026",
