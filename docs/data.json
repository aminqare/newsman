        {
          "title": "\u06a9\u0627\u062e \u0633\u0641\u06cc\u062f \u0633\u06cc\u200c\u0627\u0646\u200c\u0627\u0646  \u0631\u0627 \u0627\u0632 \u0647\u0645\u0631\u0627\u0647\u06cc \u062a\u0631\u0627\u0645\u067e \u062f\u0631 \u0647\u0648\u0627\u067e\u06cc\u0645\u0627\u06cc \u0631\u06cc\u0627\u0633\u062a\u200c\u062c\u0645\u0647\u0648\u0631\u06cc \u0645\u0646\u0639 \u06a9\u0631\u062f",
