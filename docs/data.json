        {
          "title": "\ud83d\udd34 \u062a\u0634\u06a9\u06cc\u0644 \u0646\u06cc\u0631\u0648\u06cc \u0639\u0645\u0644\u06cc\u0627\u062a\u06cc \u062c\u062f\u06cc\u062f \u0633\u0646\u062a\u06a9\u0627\u0645 \u0628\u0631\u0627\u06cc \u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u062a\u0631\u0627\u0628\u0631\u06cc \u0632\u0645\u06cc\u0646\u06cc \u062a\u0633\u0644\u06cc\u062d\u0627\u062a \u0648 \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u062a\u0648\u0633\u0637 \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646",
          "link": "https://ir.voanews.com/a/8219967.html",
          "summary": "\u0641\u0631\u0645\u0627\u0646\u062f\u0647\u06cc \u0645\u0631\u06a9\u0632\u06cc \u0627\u0631\u062a\u0634 \u0627\u06cc\u0627\u0644\u0627\u062a \u0645\u062a\u062d\u062f\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0633\u0646\u062a\u06a9\u0627\u0645\u060c \u0627\u0632 \u062a\u0634\u06a9\u06cc\u0644 \u06cc\u06a9 \u0646\u06cc\u0631\u0648\u06cc \u0639\u0645\u0644\u06cc\u0627\u062a\u06cc \u062c\u062f\u06cc\u062f \u0628\u0631\u0627\u06cc \u0645\u062d\u062f\u0648\u062f \u06a9\u0631\u062f\u0646 \u0627\u0646\u062a\u0642\u0627\u0644 \u062a\u0633\u0644\u06cc\u062d\u0627\u062a \u067e\u06cc\u0634\u0631\u0641\u062a\u0647\u060c \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u062a\u062d\u0631\u06cc\u0645\u200c\u0634\u062f\u0647\u060c \u0648 \u0645\u0646\u0627\u0628\u0639 \u062f\u0631\u0622\u0645\u062f\u06cc \u063a\u06cc\u0631\u0642\u0627\u0646\u0648\u0646\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0627\u0632 \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u0632\u0645\u06cc\u0646\u06cc \u0648 \u062f\u0631\u06cc\u0627\u06cc \u062e\u0632\u0631 (\u06a9\u0627\u0633\u067e\u06cc\u0646) \u062e\u0628\u0631\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
          "source_url": "https://ir.voanews.com/api/zbtpil-vomx-tpeqiyp"
        },
