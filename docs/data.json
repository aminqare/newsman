        {
          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u06af\u0631\u0648\u0647\u06cc \u0645\u0639\u062a\u0642\u062f\u0646\u062f \u0628\u0627 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646 \u062a\u0648\u0627\u0641\u0642 \u06a9\u0631\u062f\u061b \u0631\u0698\u06cc\u0645 \u06cc\u0627 \u0628\u0627\u06cc\u062f \u06a9\u0627\u0631\u06cc \u00ab\u0647\u0648\u0634\u0645\u0646\u062f\u0627\u0646\u0647\u00bb \u06a9\u0646\u062f \u06cc\u0627 \u00ab\u0645\u062f\u062a \u0632\u06cc\u0627\u062f\u06cc\u00bb \u0639\u0645\u0631 \u0646\u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f",
          "link": "https://ir.voanews.com/a/iran-us-related-live-news-coverage/8162914.html",
          "summary": "\u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e \u0628\u0627 \u0644\u062d\u0646\u06cc \u0637\u0639\u0646\u0647\u200c\u0622\u0645\u06cc\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u06af\u0641\u062a: \u00ab\u0631\u0647\u0628\u0631\u0627\u0646\u0634\u0627\u0646 \u0631\u0641\u062a\u0647\u200c\u0627\u0646\u062f\u060c \u062f\u0631 \u0628\u06cc\u0634\u062a\u0631 \u0645\u0648\u0627\u0631\u062f. \u0631\u0647\u0628\u0631\u0627\u0646\u0634\u0627\u0646 \u0631\u0641\u062a\u0647\u200c\u0627\u0646\u062f. \u0627\u06cc\u0646 \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u0634\u06a9\u0644\u0627\u062a \u0645\u0627 \u0628\u0648\u062f. \u0631\u0627\u0633\u062a\u0634 \u0646\u0645\u06cc\u200c\u062f\u0627\u0646\u06cc\u0645 \u0628\u0627 \u0686\u0647 \u06a9\u0633\u06cc \u0628\u0627\u06cc\u062f \u0645\u0630\u0627\u06a9\u0631\u0647 \u06a9\u0646\u06cc\u0645.\u00bb \u0622\u0642\u0627\u06cc \u062a\u0631\u0627\u0645\u067e \u06af\u0641\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062a\u0644\u0627\u0634 \u0645\u06cc\u200c\u06a9\u0646\u062f\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
