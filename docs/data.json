          "title": "\u0632\u0646\u0627\u0646\u06cc \u06a9\u0647 \u062d\u06a9\u0648\u0645\u062a \u0637\u0627\u0644\u0628\u0627\u0646 \u0634\u0644\u0627\u0642 \u0632\u062f\u061b \u00ab\u0628\u0647 \u062e\u0627\u0637\u0631 \u06cc\u06a9 \u0631\u0627\u0628\u0637\u0647 \u0622\u0634\u0646\u0627\u06cc\u06cc\u060c \u0645\u0631\u0627 \u06f3\u06f9 \u0636\u0631\u0628\u0647 \u0634\u0644\u0627\u0642 \u0632\u062f\u0646\u062f\u00bb",
