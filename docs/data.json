          "title": "\u062d\u0645\u0644\u0647 \u0647\u0648\u0627\u06cc\u06cc \u0628\u0647 \u0642\u0634\u0645 \u062f\u0631 \u0648\u0627\u06a9\u0646\u0634 \u0628\u0647 \u0634\u0644\u06cc\u06a9 \u0645\u0648\u0634\u06a9 \u0628\u0647 \u0633\u0645\u062a \u062c\u0646\u06af\u0646\u062f\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc",
