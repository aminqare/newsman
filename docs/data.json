          "title": "\u06cc\u06a9 \u0645\u0642\u0627\u0645 \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc: \u062a\u0631\u0627\u0645\u067e \u0628\u0627 \u0634\u06cc \u0648 \u067e\u0648\u062a\u06cc\u0646 \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u06cc\u0631\u0627\u0646 \u06af\u0641\u062a\u06af\u0648 \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f",
