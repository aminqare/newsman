          "title": "\ud83d\udd34 \u062f\u0644\u0627\u0631 \u0628\u0627 \u0639\u0628\u0648\u0631 \u0627\u0632 \u06f2\u06f8\u06f5 \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646 \u0628\u0647 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06f3\u06f0\u06f0 \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646\u06cc \u0628\u0633\u0646\u062a \u0646\u0632\u062f\u06cc\u06a9 \u0634\u062f\u061b\n\u0648\u0632\u06cc\u0631 \u062e\u0632\u0627\u0646\u0647\u200c\u062f\u0627\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627: \u0627\u0642\u062a\u0635\u0627\u062f \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u062d\u0627\u0644 \u063a\u0631\u0642 \u0634\u062f\u0646 \u0627\u0633\u062a",
