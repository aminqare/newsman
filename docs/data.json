        {
          "title": "\u062d\u0645\u0627\u0633 \u067e\u0633 \u0627\u0632 \u062a\u0648\u0627\u0641\u0642 \u0628\u0627 \u0647\u06cc\u0626\u062a \u0635\u0644\u062d \u062a\u0631\u0627\u0645\u067e\u060c \u0628\u0627 \u062e\u0644\u0639 \u0633\u0644\u0627\u062d \u0645\u0648\u0627\u0641\u0642\u062a \u06a9\u0631\u062f\u061b \u0622\u06cc\u0627 \u0627\u06cc\u0646 \u0637\u0631\u062d \u0628\u0647 \u0633\u0631\u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0631\u0633\u062f\u061f",
