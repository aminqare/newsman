          "summary": "\u0646\u0634\u0633\u062a \u0627\u06cc\u0631\u0627\u0646 \u0628\u0627 \u067e\u0627\u06a9\u0633\u062a\u0627\u0646\u060c \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0648 \u062a\u0631\u06a9\u06cc\u0647\u060c \u0633\u0647 \u0639\u0636\u0648 \u067e\u06cc\u0645\u0627\u0646 \u0645\u06a9\u0647\u060c \u062f\u0631 \u062a\u0647\u0631\u0627\u0646 \u0628\u0647 \u067e\u0627\u06cc\u0627\u0646 \u0631\u0633\u06cc\u062f. \u0628\u0639\u062f \u0627\u0632 \u0627\u06cc\u0646 \u0646\u0634\u0633\u062a \u06a9\u0647 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0647\u062f\u0641 \u0622\u0646 \u0631\u0627 \u00ab\u067e\u06cc\u0634\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062a\u0634\u062f\u06cc\u062f \u062a\u0646\u0634 \u0648 \u0647\u0645\u0648\u0627\u0631 \u06a9\u0631\u062f\u0646 \u0631\u0627\u0647 \u06cc\u06a9 \u062a\u0648\u0627\u0641\u0642\u00bb \u0639\u0646\u0648\u0627\u0646 \u06a9\u0631\u062f\u0647 \u0628\u0648\u062f\u060c \u0645\u0633\u0639\u0648\u062f \u067e\u0632\u0634\u06a9\u06cc\u0627\u0646 \u0628\u0631\u0627\u06cc \u0634\u0631\u06a9\u062a \u062f\u0631 \u0645\u062c\u0645\u0639 \u0635\u0627\u062f\u2026",
