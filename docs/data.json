        {
          "title": "\u06a9\u0634\u0641 \u067e\u06cc\u0627\u067e\u06cc \u0627\u062c\u0633\u0627\u062f \u0632\u0646\u0627\u0646\u060c \u0645\u0648\u062c\u06cc \u0627\u0632 \u0647\u0631\u0627\u0633 \u0631\u0627 \u062f\u0631 \u0622\u0641\u0631\u06cc\u0642\u0627\u06cc \u062c\u0646\u0648\u0628\u06cc \u0628\u0647 \u0631\u0627\u0647 \u0627\u0646\u062f\u0627\u062e\u062a",
