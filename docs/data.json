          "title": "\u00ab\u062f\u0633\u062a\u0648\u0631 \u0645\u062c\u062a\u0628\u06cc \u062e\u0627\u0645\u0646\u0647\u200c\u0627\u06cc\u00bb \u0628\u0647 \u0641\u0631\u0645\u0627\u0646\u062f\u0647\u0627\u0646 \u0627\u0631\u0634\u062f \u0646\u0638\u0627\u0645\u06cc: \u067e\u0627\u0633\u062e \u0628\u0647 \u0647\u0631 \u062a\u0647\u062f\u06cc\u062f\u06cc \u0628\u062f\u0648\u0646 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a \u062c\u063a\u0631\u0627\u0641\u06cc\u0627\u06cc\u06cc \u0628\u0627\u0634\u062f",
