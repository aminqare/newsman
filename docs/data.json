          "title": "\ud83d\udd34 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648: \u0648\u0642\u062a \u0622\u0646 \u0631\u0633\u06cc\u062f\u0647 \u062a\u0647\u062f\u06cc\u062f \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0631\u0627 \u00ab\u06cc\u06a9 \u0628\u0627\u0631 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647\u00bb \u0627\u0632 \u0645\u06cc\u0627\u0646 \u0628\u0631\u062f\u0627\u0631\u06cc\u0645\u061b \u0639\u0628\u0648\u0631 \u06f1.\u06f7 \u0645\u06cc\u0644\u06cc\u0627\u0631\u062f \u0628\u0634\u06a9\u0647 \u0646\u0641\u062a \u0627\u0632 \u0647\u0631\u0645\u0632 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0633\u0646\u062a\u06a9\u0627\u0645",
