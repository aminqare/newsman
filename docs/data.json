          "summary": "\u06a9\u06cc\u0645\u06cc \u0622\u0646\u062a\u0648\u0646\u0644\u06cc \u06f1\u06f0 \u0633\u0627\u0644\u0647 \u0628\u0648\u062f \u06a9\u0647 \u067e\u062f\u0631\u0634\u060c \u0645\u0627\u0631\u06a9\u0648\u060c \u0628\u0631\u0627\u06cc \u0646\u062e\u0633\u062a\u06cc\u0646 \u0628\u0627\u0631 \u0645\u062a\u0648\u062c\u0647 \u0634\u062f \u067e\u0633\u0631\u06cc \u06a9\u0647 \u0631\u0648\u06cc \u0632\u0627\u0646\u0648\u06cc\u0634 \u0646\u0634\u0633\u062a\u0647 \u0627\u0633\u062a \u0648 \u0641\u0631\u0645\u0627\u0646 \u0648 \u062f\u0646\u062f\u0647 \u0631\u0627 \u06a9\u0646\u062a\u0631\u0644 \u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0627\u062d\u062a\u0645\u0627\u0644\u0627 \u0627\u0633\u062a\u0639\u062f\u0627\u062f\u06cc \u0627\u0633\u062a\u062b\u0646\u0627\u06cc\u06cc \u062f\u0631 \u0631\u0627\u0646\u0646\u062f\u06af\u06cc \u0633\u0637\u062d \u0628\u0627\u0644\u0627 \u062f\u0627\u0631\u062f.",
