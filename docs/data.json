          "title": "\u0646\u06cc\u0631\u0648\u06cc \u062f\u0631\u06cc\u0627\u06cc\u06cc \u0633\u067e\u0627\u0647: \u06cc\u06a9 \u0632\u0647\u067e\u0627\u062f \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0631\u0627 \u0628\u0647 \u062f\u0627\u0645 \u0627\u0646\u062f\u0627\u062e\u062a\u06cc\u0645",
