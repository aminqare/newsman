        {
          "title": "\u0622\u063a\u0627\u0632 \u0627\u062c\u0631\u0627\u06cc \u067e\u0631\u0648\u0698\u0647 \u00ab\u0645\u0633\u06cc\u0631 \u062a\u0631\u0627\u0645\u067e\u00bb \u062f\u0631 \u0627\u0631\u0645\u0646\u0633\u062a\u0627\u0646\u061b \u0627\u06cc\u0631\u0627\u0646: \u0635\u0631\u0641\u0627 \u0628\u0647 \u0627\u0637\u0645\u06cc\u0646\u0627\u0646\u200c\u0647\u0627\u06cc \u0627\u06cc\u0631\u0648\u0627\u0646 \u062a\u06a9\u06cc\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645",
