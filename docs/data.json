          "summary": "\u067e\u0644\u06cc\u0633 \u0636\u062f\u062a\u0631\u0648\u0631\u06cc\u0633\u0645 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u06a9\u0647 \u06cc\u06a9 \u0633\u0631\u0628\u0627\u0632 \u0627\u0631\u062a\u0634 \u0627\u06cc\u0627\u0644\u0627\u062a \u0645\u062a\u062d\u062f\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0647 \u0638\u0646 \u062c\u0627\u0633\u0648\u0633\u06cc \u0628\u0631\u0627\u06cc \u0631\u0648\u0633\u06cc\u0647 \u0628\u0627\u0632\u062f\u0627\u0634\u062a \u0634\u062f\u0647 \u0627\u0633\u062a. \u0627\u06cc\u0646 \u0646\u0638\u0627\u0645\u06cc \u0627\u0631\u0634\u062f \u06f4\u06f1 \u0633\u0627\u0644\u0647\u060c \u0631\u0648\u0632 \u0633\u0647\u200c\u0634\u0646\u0628\u0647 \u062f\u0631 \u0646\u0632\u062f\u06cc\u06a9\u06cc \u0634\u0647\u0631 \u00ab\u06af\u0644\u0627\u0633\u062a\u0631\u00bb \u062f\u0633\u062a\u06af\u06cc\u0631 \u0634\u062f.",
