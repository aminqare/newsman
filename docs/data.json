        {
          "title": "\u0631\u0627\u0628\u0637\u0647 \u062c\u0646\u0633\u06cc \u06a9\u0645\u062a\u0631\u060c \u067e\u0648\u0631\u0646 \u0628\u06cc\u0634\u062a\u0631\u061b \u062a\u063a\u06cc\u06cc\u0631 \u0631\u0641\u062a\u0627\u0631 \u062c\u0646\u0633\u06cc \u062c\u0648\u0627\u0646\u0627\u0646 \u062f\u0631 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627",
