        {
          "title": "\u00ab\u0631\u0648\u0632\u0647\u0627\u06cc \u0627\u0645\u0646 \u0628\u0647 \u067e\u0627\u06cc\u0627\u0646 \u0631\u0633\u06cc\u062f\u0647 \u0627\u0633\u062a\u00bb\u061b \u0637\u0631\u062d \u062c\u062f\u06cc\u062f \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0631\u0627\u06cc \u062f\u0641\u0627\u0639 \u0627\u0632 \u067e\u0627\u06cc\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0647\u0648\u0627\u06cc\u06cc\u200c\u0627\u0634 \u0686\u06cc\u0633\u062a\u061f",
