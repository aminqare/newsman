        {
          "title": "\u067e\u0633 \u0627\u0632 \u0647\u0641\u062a\u0647\u200c\u0647\u0627 \u062e\u0634\u0648\u0646\u062a\u060c \u0641\u0634\u0627\u0631\u0647\u0627 \u0628\u0631 \u062f\u0648\u0644\u062a \u0641\u0631\u0627\u0646\u0633\u0647 \u0627\u0641\u0632\u0627\u06cc\u0634 \u06cc\u0627\u0641\u062a\u0647 \u0627\u0633\u062a",
