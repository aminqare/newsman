        {
          "title": "\u0632\u0644\u0646\u0633\u06a9\u06cc: \u0622\u0645\u0631\u06cc\u06a9\u0627 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u06a9\u0631\u062f\u0647 \u06a9\u0647 \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646 \u062f\u0631 \u0627\u0632\u0627\u06cc \u0639\u0636\u0648\u06cc\u062a \u062f\u0631 \u0646\u0627\u062a\u0648\u060c \u0627\u0632 \u062f\u0648\u0646\u0628\u0627\u0633 \u0635\u0631\u0641\u200c\u0646\u0638\u0631 \u06a9\u0646\u062f",
