        {
          "title": "\u0686\u0631\u0627 \u0632\u0628\u0627\u0646 \u0686\u06cc\u0646\u06cc \u0628\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u062a\u0627\u0632\u0647 \u062c\u0648\u0627\u0646\u0627\u0646 \u0639\u0631\u0628 \u062a\u0628\u062f\u06cc\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a\u061f",
