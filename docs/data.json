        {
          "title": "\u0631\u0636\u0627\u06cc\u06cc: \u062d\u0645\u0627\u0642\u062a \u062a\u0631\u0627\u0645\u067e \u062f\u0646\u06cc\u0627 \u0631\u0627 \u0628\u0647 \u0633\u0645\u062a \u062f\u0633\u062a\u06cc\u0627\u0628\u06cc \u0628\u0647 \u0628\u0645\u0628 \u0627\u062a\u0645 \u0633\u0648\u0642 \u062f\u0627\u062f\u0647 \u0627\u0633\u062a",
