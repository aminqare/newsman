        {
          "title": "\u0641\u0631\u0627\u0646\u0633\u0647 \u062f\u0631 \u0648\u0627\u06a9\u0646\u0634 \u0628\u0647 \u00ab\u062d\u0645\u0644\u0647 \u0633\u0627\u06cc\u0628\u0631\u06cc \u0633\u067e\u0627\u0647\u00bb \u0633\u0641\u06cc\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u0627\u062d\u0636\u0627\u0631 \u06a9\u0631\u062f\u061b \u0627\u06cc\u0631\u0627\u0646 \u0627\u062a\u0647\u0627\u0645\u200c\u0647\u0627\u06cc \u00ab\u0628\u06cc\u200c\u0627\u0633\u0627\u0633\u00bb \u0631\u0627 \u0645\u062d\u06a9\u0648\u0645 \u06a9\u0631\u062f",
          "link": "https://www.bbc.com/persian/articles/cm4g1gy13558o?at_medium=RSS&at_campaign=rss",
          "summary": "\u0641\u0631\u0627\u0646\u0633\u0647 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06a9\u0647 \u062f\u0631 \u0648\u0627\u06a9\u0646\u0634 \u0628\u0647 \u00ab\u062d\u0645\u0644\u0647 \u0633\u0627\u06cc\u0628\u0631\u06cc \u0633\u067e\u0627\u0647 \u067e\u0627\u0633\u062f\u0627\u0631\u0627\u0646\u00bb \u0633\u0641\u06cc\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u0635\u0628\u062d \u0633\u0647\u200c\u0634\u0646\u0628\u0647 \u0631\u0627 \u0627\u062d\u0636\u0627\u0631 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a. \u0627\u06cc\u0631\u0627\u0646 \u0627\u06cc\u0646 \u0627\u062a\u0647\u0627\u0645 \u0631\u0627 \u00ab\u0641\u0631\u0627\u0641\u06a9\u0646\u06cc\u00bb \u0628\u0631\u0627\u06cc \u00ab\u0627\u0646\u062d\u0631\u0627\u0641 \u0627\u0641\u06a9\u0627\u0631 \u0639\u0645\u0648\u0645\u06cc\u00bb \u0641\u0631\u0627\u0646\u0633\u0647 \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0631\u062f.",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
          "source_url": "https://feeds.bbci.co.uk/persian/rss.xml"
        },
        {
          "title": "\u062a\u0639\u062f\u0627\u062f\u06cc \u0627\u0632 \u0647\u0648\u0627\u067e\u06cc\u0645\u0627\u0647\u0627\u06cc \u0646\u0638\u0627\u0645\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u06cc\u06a9 \u067e\u0627\u06cc\u06af\u0627\u0647 \u062f\u06cc\u06af\u0631 \u062f\u0631 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0631\u0627 \u00ab\u062a\u0631\u06a9\u00bb \u06a9\u0631\u062f\u0646\u062f",
