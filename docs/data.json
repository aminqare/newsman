        {
          "title": "\u0641\u0631\u0627\u0646\u0633\u0647 \u0633\u067e\u0627\u0647 \u0631\u0627 \u0628\u0647 \u062f\u0633\u062a \u062f\u0627\u0634\u062a\u0646 \u062f\u0631 \u062d\u0645\u0644\u0647 \u0633\u0627\u06cc\u0628\u0631\u06cc \u0628\u0647 \u06cc\u062e\u0686\u0627\u0644 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627 \u0645\u062a\u0647\u0645 \u06a9\u0631\u062f",
