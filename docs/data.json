          "title": "\ud83d\udd34 \u067e\u0631\u0632\u06cc\u062f\u0646\u062a \u062a\u0631\u0627\u0645\u067e: \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0632 \u0633\u0627\u0644 \u06f1\u06f3\u06f5\u06f7 \u062c\u0646\u06af \u0628\u0627 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0631\u0627 \u0622\u063a\u0627\u0632 \u06a9\u0631\u062f\u061b \u062a\u0627\u06a9\u06cc\u062f \u0641\u0631\u0645\u0627\u0646\u062f\u0647 \u0633\u0646\u062a\u06a9\u0627\u0645 \u0628\u0631 \u0628\u0627\u0632 \u0628\u0648\u062f\u0646 \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u0627\u0635\u0644\u06cc \u06a9\u0634\u062a\u06cc\u0631\u0627\u0646\u06cc \u062f\u0631 \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632",
          "link": "https://ir.voanews.com/a/8214778.html",
          "summary": "\u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e\u060c \u0631\u0626\u06cc\u0633 \u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0628\u0627 \u062a\u0623\u06a9\u06cc\u062f \u0628\u0631 \u0627\u06cc\u0646 \u06a9\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0627\u0632 \u0632\u0645\u0627\u0646 \u0631\u0648\u06cc \u06a9\u0627\u0631 \u0622\u0645\u062f\u0646 \u062f\u0631 \u0633\u0627\u0644 \u06f1\u06f9\u06f7\u06f9 (\u06f1\u06f3\u06f5\u06f7) \u0622\u063a\u0627\u0632\u06af\u0631 \u062c\u0646\u06af \u0648 \u062f\u0634\u0645\u0646\u06cc \u0628\u0627 \u0627\u06cc\u0627\u0644\u0627\u062a \u0645\u062a\u062d\u062f\u0647 \u0628\u0648\u062f\u0647 \u0627\u0633\u062a\u060c \u06af\u0641\u062a \u0648\u0627\u0634\u0646\u06af\u062a\u0646 \u062c\u0646\u06af \u06a9\u0646\u0648\u0646\u06cc \u0628\u0627 \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u0622\u063a\u0627\u0632 \u0646\u06a9\u0631\u062f\u0647 \u0627\u0633\u062a \u0648 \u067e\u06cc\u0634\u200c\u0628\u06cc\u0646\u06cc \u06a9\u0631\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
