          "title": "\u0628\u0633\u0646\u062a: \u0622\u0633\u0645\u0627\u0646 \u062f\u0646\u06cc\u0627 \u0627\u0632 \u067e\u0633\u200c\u0641\u0631\u062f\u0627 \u0628\u0647 \u0631\u0648\u06cc \u062a\u0645\u0627\u0645 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0647\u0648\u0627\u06cc\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0628\u0633\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f",
