          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632 \u0631\u0627 \u062f\u0631 \u06a9\u0646\u062a\u0631\u0644 \u062f\u0627\u0631\u06cc\u0645\u061b \u062c\u06cc\u200c\u062f\u06cc \u0648\u0646\u0633: \u0645\u0647\u0645\u062a\u0631\u06cc\u0646 \u062e\u0648\u0627\u0633\u062a\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u0645\u0630\u0627\u06a9\u0631\u0627\u062a \u0639\u062f\u0645 \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u0627\u0628\u0648\u062f\u200c\u0634\u062f\u0647 \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0627\u0633\u062a",
