        {
          "title": "\u067e\u0646\u062c \u0633\u0627\u0644 \u062d\u06a9\u0648\u0645\u062a \u0637\u0627\u0644\u0628\u0627\u0646\u061b \u0686\u0647 \u0686\u06cc\u0632\u0647\u0627\u06cc\u06cc \u062f\u0631 \u00ab\u0627\u0631\u06af\u00bb\u060c \u0633\u0627\u062e\u062a\u0645\u0627\u0646 \u0631\u06cc\u0627\u0633\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0633\u0627\u0628\u0642\u060c \u062a\u063a\u06cc\u06cc\u0631 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a\u061f",
