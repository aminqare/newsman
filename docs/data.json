          "title": "\u067e\u0627\u06a9\u0633\u062a\u0627\u0646: \u062a\u0648\u0627\u0641\u0642 \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0631\u0627\u0647 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u062f\u0627\u0645\u0647 \u0645\u0630\u0627\u06a9\u0631\u0627\u062a \u0641\u0646\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0648 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0647\u0645\u0648\u0627\u0631 \u06a9\u0646\u062f",
