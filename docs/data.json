        {
          "title": "\u0686\u06af\u0648\u0646\u0647 \u0631\u0628\u0627\u062a\u200c\u0647\u0627 \u0628\u0647 \u0634\u06a9\u0627\u0631\u0686\u06cc\u0627\u0646 \u0645\u06cc\u0646 \u062f\u0631 \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632 \u062a\u0628\u062f\u06cc\u0644 \u0634\u062f\u0646\u062f\u061f",
