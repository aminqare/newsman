        {
          "title": "\u0641\u06cc\u0644\u0645\u06cc \u0686\u0647\u0627\u0631 \u0633\u0627\u0639\u062a\u0647 \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u06cc\u0644\u0627\u0646 \u0645\u0627\u0633\u06a9\u061b \u067e\u0631\u062a\u0631\u0647\u200c\u0627\u06cc \u062c\u0646\u062c\u0627\u0644\u06cc \u0627\u0632 \u062b\u0631\u0648\u062a\u0645\u0646\u062f\u062a\u0631\u06cc\u0646 \u0645\u0631\u062f \u062c\u0647\u0627\u0646",
