          "summary": "\u0627\u06af\u0631 \u06cc\u06a9 \u0631\u0648\u0632 \u0634\u0631\u06a9\u062a \u0633\u0627\u0632\u0646\u062f\u0647 \u0686\u062a\u200c\u0628\u0627\u062a\u06cc \u06a9\u0647 \u0631\u0627\u0632\u0647\u0627\u06cc\u062a\u0627\u0646 \u0631\u0627 \u0628\u0627 \u0622\u0646 \u062f\u0631 \u0645\u06cc\u0627\u0646 \u06af\u0630\u0627\u0634\u062a\u0647\u200c\u0627\u06cc\u062f \u0648\u0631\u0634\u06a9\u0633\u062a \u0634\u0648\u062f\u060c \u0686\u0647 \u0628\u0631 \u0633\u0631 \u0622\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062e\u0648\u0627\u0647\u062f \u0622\u0645\u062f\u061f \u0646\u06af\u0631\u0627\u0646\u06cc\u200c\u0647\u0627 \u062f\u0631\u0628\u0627\u0631\u0647 \u0633\u0631\u0646\u0648\u0634\u062a \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u0631 \u0634\u0631\u06a9\u062a \u00ab\u06a9\u0627\u0631\u0627\u06a9\u062a\u0631.\u0627\u06cc\u200c\u0622\u06cc\u00bb \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u062a\u0648\u062c\u0647\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647 \u062e\u0637\u0631\u06cc \u062c\u0644\u0628 \u06a9\u0631\u062f\u0647 \u06a9\u0647\u2026",
