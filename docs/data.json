        {
          "title": "\ud83d\udd34 \u062f\u0644\u0627\u0631 \u0628\u0627 \u062b\u0628\u062a \u0631\u06a9\u0648\u0631\u062f\u06cc \u062a\u0627\u0632\u0647 \u0627\u0632 \u06f2\u06f0\u06f0 \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646 \u0641\u0631\u0627\u062a\u0631 \u0631\u0641\u062a\u061b \u0628\u0627\u0646\u06a9 \u0645\u0631\u06a9\u0632\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0622\u0632\u0627\u062f\u0633\u0627\u0632\u06cc \u0645\u0646\u0627\u0628\u0639 \u0645\u0633\u062f\u0648\u062f\u0634\u062f\u0647 \u0645\u062a\u0648\u0642\u0641 \u0645\u0627\u0646\u062f\u0647 \u0627\u0633\u062a",
          "link": "https://ir.voanews.com/a/iran-us-related-live-news-coverage/8162914.html",
          "summary": "\u0642\u06cc\u0645\u062a \u062f\u0644\u0627\u0631 \u062f\u0631 \u0628\u0627\u0632\u0627\u0631 \u0622\u0632\u0627\u062f \u0627\u0632 \u0645\u0631\u0632 \u06f2\u06f0\u06f0 \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646 \u06af\u0630\u0634\u062a \u0648 \u0631\u06a9\u0648\u0631\u062f \u062a\u0627\u0631\u06cc\u062e\u06cc \u062a\u0627\u0632\u0647\u200c\u0627\u06cc \u062b\u0628\u062a \u06a9\u0631\u062f. \u0633\u06a9\u0647 \u0628\u0647 \u06f2\u06f1\u06f8 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u062a\u0648\u0645\u0627\u0646 \u0631\u0633\u06cc\u062f \u0648 \u0647\u0631 \u067e\u0648\u0646\u062f \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0627\u0632 \u06f2\u06f7\u06f0 \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646 \u0641\u0631\u0627\u062a\u0631 \u0631\u0641\u062a. \u0647\u0645\u0632\u0645\u0627\u0646 \u0628\u0627\u0646\u06a9 \u0645\u0631\u06a9\u0632\u06cc \u062a\u0623\u06cc\u06cc\u062f \u06a9\u0631\u062f \u062a\u0641\u0627\u0647\u0645 \u0627\u0633\u0644\u0627\u0645\u200c\u0622\u0628\u0627\u062f \u0628\u0631\u0627\u06cc \u0622\u0632\u0627\u062f\u0633\u0627\u0632\u06cc\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
