        {
          "title": "\u0633\u0647 \u0639\u0627\u0645\u0644 \u0627\u0635\u0644\u06cc \u062f\u0631 \u067e\u06cc\u0631\u0648\u0632\u06cc \u062a\u0627\u0631\u06cc\u062e\u06cc \u0644\u0648\u0644\u0627 \u0628\u0631\u0627\u06cc \u0686\u0647\u0627\u0631\u0645\u06cc\u0646 \u062f\u0648\u0631\u0647 \u0631\u06cc\u0627\u0633\u062a\u200c\u062c\u0645\u0647\u0648\u0631\u06cc \u0628\u0631\u0632\u06cc\u0644",
