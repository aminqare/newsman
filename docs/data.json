        {
          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u06cc\u06a9 \u00ab\u062e\u0634\u0645 \u062d\u0645\u0627\u0633\u06cc\u00bb \u062f\u06cc\u06af\u0631 \u0639\u0644\u06cc\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u0645\u061b \u06cc\u0627 \u06a9\u0627\u0631 \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u06cc\u06a9\u0633\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645 \u06cc\u0627 \u0645\u06cc\u200c\u06af\u0630\u0627\u0631\u06cc\u0645 \u0627\u0632 \u062f\u0631\u0648\u0646 \u0641\u0631\u0648 \u0628\u067e\u0627\u0634\u062f",
          "link": "https://ir.voanews.com/a/8212243.html",
          "summary": "\u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e\u060c \u0631\u0626\u06cc\u0633 \u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0631\u0648\u0632 \u062c\u0645\u0639\u0647 \u0627\u0648\u0644 \u0622\u0628\u0627\u0646 \u062f\u0631 \u06cc\u06a9 \u0633\u062e\u0646\u0631\u0627\u0646\u06cc \u062f\u0631 \u0627\u06cc\u0627\u0644\u062a \u0641\u0644\u0648\u0631\u06cc\u062f\u0627 \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u062d\u062a\u0645\u0627\u0644 \u0627\u0646\u062c\u0627\u0645 \u0639\u0645\u0644\u06cc\u0627\u062a \u0646\u0638\u0627\u0645\u06cc \u062f\u06cc\u06af\u0631\u06cc \u0639\u0644\u06cc\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u06af\u0641\u062a: \u00ab\u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u06cc\u06a9 \u062e\u0634\u0645 \u062d\u0645\u0627\u0633\u06cc \u06a9\u0648\u0686\u06a9 \u062f\u06cc\u06af\u0631 \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u0645.\u00bb \u0622\u0642\u0627\u06cc \u062a\u0631\u0627\u0645\u067e \u06af\u0641\u062a \u0631\u0647\u0628\u0631\u0627\u0646 \u0631\u0698\u06cc\u0645\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
