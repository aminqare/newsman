          "title": "\u0631\u0648\u0628\u06cc\u0648: \u062a\u0631\u0627\u0645\u067e \u0647\u0646\u0648\u0632 \u062f\u0631 \u0645\u0648\u0631\u062f \u062d\u0645\u0644\u0647 \u0628\u0647 \u0627\u06cc\u0631\u0627\u0646 \u062a\u0635\u0645\u06cc\u0645 \u0646\u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a",
