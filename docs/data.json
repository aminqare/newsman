        {
          "title": "\u062d\u0630\u0641 \u0645\u0648\u0646\u0627\u0644\u06cc\u0632\u0627 \u0648 \u0627\u0641\u0632\u0648\u062f\u0646 \u0631\u0648\u0633\u0631\u06cc \u0628\u0647 \u062a\u0635\u0627\u0648\u06cc\u0631\u061b \u062c\u0646\u062c\u0627\u0644 \u062a\u0627\u0632\u0647 \u0628\u0631 \u0633\u0631 \u06a9\u062a\u0627\u0628\u200c\u0647\u0627\u06cc \u062f\u0631\u0633\u06cc \u062c\u062f\u06cc\u062f \u0633\u0648\u0631\u06cc\u0647",
