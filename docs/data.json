        {
          "title": "\u0622\u0646\u0686\u0647 \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0645\u06cc\u0627\u0646\u200c\u062f\u0648\u0631\u0647\u200c\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0627\u06cc\u062f \u0628\u062f\u0627\u0646\u06cc\u062f",
