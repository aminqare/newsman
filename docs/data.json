        {
          "title": "\u0646\u062e\u0633\u062a\u06cc\u0646 \u06a9\u0646\u0633\u0631\u062a \u067e\u0633 \u0627\u0632 \u06a9\u0646\u0627\u0631 \u06af\u0630\u0627\u0634\u062a\u0646 \u0631\u067e\u0631 \u062d\u0627\u0645\u06cc \u0641\u0644\u0633\u0637\u06cc\u0646\u061b \u0627\u062f \u0634\u06cc\u0631\u0646 \u0628\u0631\u0627\u06cc \u00ab\u0627\u0634\u062a\u0628\u0627\u0647\u0627\u062a\u0634\u00bb \u0639\u0630\u0631\u062e\u0648\u0627\u0647\u06cc \u06a9\u0631\u062f",
