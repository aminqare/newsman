          "title": "\u00ab\u0627\u062f\u0627\u0645\u0647\u00bb \u06af\u0641\u062a\u200c\u0648\u200c\u06af\u0648\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0648 \u0645\u06cc\u0627\u0646\u062c\u06cc\u200c\u0647\u0627\u06cc \u0642\u0637\u0631\u06cc \u062f\u0631 \u062f\u0648\u062d\u0647 \u0647\u0645\u200c\u0632\u0645\u0627\u0646 \u0628\u0627 \u062a\u0647\u062f\u06cc\u062f\u0647\u0627\u06cc \u0645\u062a\u0642\u0627\u0628\u0644 \u0627\u06cc\u0631\u0627\u0646 \u0648 \u0622\u0645\u0631\u06cc\u06a9\u0627",
