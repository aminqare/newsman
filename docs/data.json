          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0645\u0646\u0637\u0642\u0647 \u062e\u0648\u0627\u0647\u0627\u0646 \u0627\u062f\u0627\u0645\u0647 \u0645\u062d\u0627\u0635\u0631\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0647\u0633\u062a\u0646\u062f\u061b \u0645\u0627 \u0628\u0631\u0627\u06cc \u0636\u0631\u0628\u0647\u200c\u0632\u062f\u0646 \u0622\u0645\u0627\u062f\u0647\u200c\u0627\u06cc\u0645\u061b \u0648\u0632\u06cc\u0631 \u062c\u0646\u06af \u0622\u0645\u0631\u06cc\u06a9\u0627: \u0631\u0648\u06cc\u0627\u0631\u0648\u06cc\u06cc \u0628\u0627 \u0631\u0698\u06cc\u0645 \u0636\u0631\u0648\u0631\u06cc \u0628\u0648\u062f",
