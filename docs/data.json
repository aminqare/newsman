        {
          "title": "\u0645\u062d\u0645\u062f \u0639\u0638\u06cc\u0645\u200c\u0632\u0627\u062f\u0647\u060c \u0628\u0627\u0632\u06cc\u06af\u0631 \u0646\u0645\u0627\u06cc\u0634 \u00ab\u0632\u0627\u0644 \u0648 \u0631\u0648\u062f\u0627\u0628\u0647\u00bb \u0648 \u0647\u0646\u0631\u067e\u06cc\u0634\u0647 \u062c\u0648\u0627\u0646 \u0627\u067e\u0631\u0627 \u0648 \u0628\u0627\u0644\u0647 \u062a\u0627\u062c\u06cc\u06a9\u0633\u062a\u0627\u0646 \u062f\u0631\u06af\u0630\u0634\u062a",
