          "title": "\u062d\u0627\u062f\u062b\u0647\u200c \u0645\u0647\u0645 \u0627\u0645\u0646\u06cc\u062a\u06cc \u062f\u0631 \u0646\u0632\u062f\u06cc\u06a9\u06cc \u067e\u0627\u06cc\u06af\u0627\u0647 \u0646\u06cc\u0631\u0648\u06cc \u0647\u0648\u0627\u06cc\u06cc \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627\u061b \u0686\u0646\u062f \u0645\u0631\u062f \u0628\u0627\u0632\u062f\u0627\u0634\u062a \u0634\u062f\u0646\u062f",
