          "title": "\u0631\u0626\u06cc\u0633 \u062c\u0645\u0647\u0648\u0631 \u06a9\u0631\u0647 \u062c\u0646\u0648\u0628\u06cc: \u062f\u0631 \u062c\u0646\u06af \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646 \u0645\u062f\u0627\u062e\u0644\u0647 \u0646\u062e\u0648\u0627\u0647\u06cc\u0645 \u06a9\u0631\u062f",
