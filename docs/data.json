        {
          "title": "\u06a9\u0634\u0645\u06a9\u0634 \u0628\u0631 \u0633\u0631 \u0622\u06cc\u0646\u062f\u0647 \u062c\u0646\u06af \u0627\u06cc\u0631\u0627\u0646\u061b \u0627\u0632 \u0641\u0634\u0627\u0631 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648 \u062a\u0627 \u0645\u0642\u0627\u0648\u0645\u062a \u062f\u0645\u0648\u06a9\u0631\u0627\u062a\u200c\u0647\u0627",
