        {
          "title": "\u062a\u06cc\u0631\u0627\u0646\u062f\u0627\u0632\u06cc \u062f\u0631 \u0645\u062f\u0631\u0633\u0647 \u0627\u0648\u0631\u06af\u0646\u061b \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u0639\u0644\u0645\u0627\u0646 \u0628\u0627 \u062f\u0631\u06af\u06cc\u0631 \u0634\u062f\u0646 \u0628\u0627 \u062a\u06cc\u0631\u0627\u0646\u062f\u0627\u0632 \u062c\u0644\u0648\u06cc \u0641\u0627\u062c\u0639\u0647 \u0628\u06cc\u0634\u062a\u0631 \u0631\u0627 \u06af\u0631\u0641\u062a",
