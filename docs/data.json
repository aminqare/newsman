        {
          "title": "\u062a\u0638\u0627\u0647\u0631\u0627\u062a \u0647\u0632\u0627\u0631\u0627\u0646 \u0646\u0641\u0631 \u0639\u0644\u06cc\u0647 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648 \u062f\u0631 \u062a\u0644\u200c\u0622\u0648\u06cc\u0648\u060c \u0633\u0647 \u0631\u0648\u0632 \u0645\u0627\u0646\u062f\u0647 \u0628\u0647 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0627\u0633\u0631\u0627\u0626\u06cc\u0644",
