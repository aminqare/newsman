          "title": "\u0646\u062e\u0633\u062a\u06cc\u0646 \u0633\u0641\u0631 \u0644\u0627\u0648\u0631\u0648\u0641 \u0628\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0632 \u0632\u0645\u0627\u0646 \u062d\u0645\u0644\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644",
          "link": "https://www.bbc.co.uk/persian/live/cqvgr3kpl8dkt?at_medium=RSS&at_campaign=rss",
          "summary": "\u0633\u0631\u06af\u0626\u06cc \u0644\u0627\u0648\u0631\u0648\u0641 \u062f\u0631 \u0646\u062e\u0633\u062a\u06cc\u0646 \u0633\u0641\u0631 \u0628\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0632 \u0632\u0645\u0627\u0646 \u062d\u0645\u0644\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644\u060c \u0648\u0627\u0631\u062f \u062a\u0647\u0631\u0627\u0646 \u0634\u062f. \u0648\u0632\u06cc\u0631 \u062e\u0627\u0631\u062c\u0647 \u0631\u0648\u0633\u06cc\u0647 \u0628\u0627 \u0639\u0628\u0627\u0633 \u0639\u0631\u0627\u0642\u0686\u06cc \u0648 \u0645\u0633\u0639\u0648\u062f \u067e\u0632\u0634\u06a9\u06cc\u0627\u0646 \u062f\u06cc\u062f\u0627\u0631 \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f. \u0645\u0633\u06a9\u0648 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u062f\u0631 \u062a\u0644\u0627\u0634 \u0627\u0633\u062a \u062a\u0627 \u0627\u0632 \u062c\u0646\u06af \u06af\u0633\u062a\u0631\u062f\u0647 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u06a9\u0646\u062f. \u0645\u0642\u0627\u0645\u200c\u0647\u0627\u06cc \u0646\u0638\u0627\u0645\u06cc \u0648\u2026",
