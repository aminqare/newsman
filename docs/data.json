          "title": "\u0636\u0631\u0631\u06cc \u06a9\u0647 \u0628\u0647 \u062c\u06cc\u0628 \u0648 \u062c\u0627\u0646\u0645\u0627\u0646 \u0645\u06cc\u200c\u0632\u0646\u06cc\u0645\u061b \u00ab\u0627\u0632 \u0631\u06cc\u0634\u0647 \u062a\u0627 \u0646\u0648\u06a9\u00bb \u0628\u062e\u0648\u0631\u06cc\u062f",
