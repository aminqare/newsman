          "title": "\u0631\u062f\u06af\u06cc\u0631\u06cc \u00ab\u0639\u0646\u06a9\u0628\u0648\u062a\u00bb \u0627\u0633\u062f\u061b \u0627\u0632 \u062f\u0641\u062a\u0631\u0686\u0647 \u062a\u0644\u0641\u0646 \u062f\u0645\u0634\u0642 \u062a\u0627 \u0645\u062e\u0641\u06cc\u06af\u0627\u0647\u06cc \u062f\u0631 \u0645\u0633\u06a9\u0648",
