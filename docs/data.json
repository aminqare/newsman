          "title": "\u0633\u067e\u0627\u0647 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0631\u0627\u062f\u0627\u0631 \u067e\u062f\u0627\u0641\u0646\u062f\u06cc \u06cc\u06a9 \u067e\u0627\u06cc\u06af\u0627\u0647 \u0646\u0638\u0627\u0645\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u0628\u062d\u0631\u06cc\u0646 \u0631\u0627 \u0647\u062f\u0641 \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u0647 \u0627\u0633\u062a",
