        {
          "title": "\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627\u061b \u062c\u062f\u0627\u0644 \u067e\u0631\u0645\u0627\u062c\u0631\u0627\u06cc \u0633\u06cc\u062f \u0648 \u0631\u0627\u062c\u0631\u0632 \u062f\u0631 \u0645\u06cc\u0634\u06cc\u06af\u0627\u0646",
