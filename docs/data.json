          "title": "\u0645\u0635\u0631 \u0648 \u067e\u06cc\u0645\u0627\u0646 \u0645\u06a9\u0647\u061b \u0646\u06af\u0631\u0627\u0646\u06cc \u0642\u0627\u0647\u0631\u0647 \u0627\u0632 \u062f\u0631\u06af\u06cc\u0631\u06cc \u0628\u0627 \u062d\u0648\u062b\u06cc\u200c\u0647\u0627 \u0648 \u0627\u06cc\u0631\u0627\u0646",
