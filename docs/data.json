          "summary": "\u062f\u0644\u0627\u0631 \u0631\u0648\u0632 \u0633\u0647\u200c\u0634\u0646\u0628\u0647 \u062a\u0627 \u06f2\u06f8\u06f5 \u0647\u0632\u0627\u0631 \u0648 \u06f2\u06f0\u06f0 \u062a\u0648\u0645\u0627\u0646 \u0628\u0627\u0644\u0627 \u0631\u0641\u062a \u0648 \u0631\u06a9\u0648\u0631\u062f \u062a\u0627\u0632\u0647\u200c\u0627\u06cc \u062b\u0628\u062a \u06a9\u0631\u062f. \u0631\u06a9\u0648\u0631\u062f \u067e\u06cc\u0634\u06cc\u0646\u060c \u06f2\u06f7\u06f4 \u0647\u0632\u0627\u0631 \u0648 \u06f5\u06f0\u06f0 \u062a\u0648\u0645\u0627\u0646\u060c \u06f1\u06f2 \u0622\u0628\u0627\u0646 \u062b\u0628\u062a \u0634\u062f\u0647 \u0628\u0648\u062f. \u0627\u06cc\u0646 \u0645\u0648\u062c \u0627\u0641\u0632\u0627\u06cc\u0634 \u0642\u06cc\u0645\u062a \u067e\u0633 \u0627\u0632 \u0627\u0639\u0644\u0627\u0645 \u062a\u062d\u0631\u06cc\u0645\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0635\u0648\u0631\u062a \u06af\u0631\u0641\u062a. \u062b\u0628\u062a \u0627\u06cc\u0646 \u0631\u06a9\u0648\u0631\u062f \u062f\u0631 \u062d\u0627\u0644\u06cc \u0627\u2026",
