        {
          "title": "\u0645\u062d\u0627\u06a9\u0645\u0647 \u0648\u0627\u0631\u062b \u06cc\u06a9 \u0631\u0633\u062a\u0648\u0631\u0627\u0646 \u0632\u0646\u062c\u06cc\u0631\u0647\u200c\u0627\u06cc \u062f\u0631 \u0622\u0644\u0645\u0627\u0646\u061b \u0627\u0632 \u0627\u062a\u0647\u0627\u0645 \u0631\u0628\u0648\u062f\u0646 \u0641\u0631\u0632\u0646\u062f\u0627\u0646 \u062a\u0627 \u0631\u0633\u0648\u0627\u06cc\u06cc \u062c\u0627\u0633\u0648\u0633\u06cc",
