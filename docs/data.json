          "title": "\u0627\u0632 \u0622\u0698\u0627\u0646\u0633 \u0645\u062f\u0644\u06cc\u0646\u06af \u062a\u0627 \u062e\u0627\u0646\u0647 \u0627\u067e\u0633\u062a\u06cc\u0646\u061b \u0631\u0648\u0627\u06cc\u062a \u0632\u0646\u06cc \u06a9\u0647 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0628\u0627\u0631\u0647\u0627 \u0645\u0648\u0631\u062f \u062a\u062c\u0627\u0648\u0632 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a",
