          "title": "\u0631\u0648\u06cc\u062a\u0631\u0632: \u0645\u0634\u0627\u0648\u0631 \u0627\u0631\u0634\u062f \u0646\u062e\u0633\u062a\u200c\u0648\u0632\u06cc\u0631 \u0642\u0637\u0631 \u0628\u0647 \u062a\u0647\u0631\u0627\u0646 \u0631\u0641\u062a",
