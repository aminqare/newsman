        {
          "title": "\u062a\u0628\u0644\u06cc\u063a \u062c\u0646\u062c\u0627\u0644\u06cc \u0633\u06cc\u062f\u0646\u06cc \u0633\u0648\u0626\u06cc\u0646\u06cc \u0628\u0631\u0627\u06cc \u06cc\u06a9 \u0633\u0627\u06cc\u062a \u0634\u0631\u0637\u200c\u0628\u0646\u062f\u06cc\u061b \u0686\u0631\u0627 \u0648\u0631\u0632\u0634\u06a9\u0627\u0631\u0627\u0646 \u0632\u0646 \u062e\u0634\u0645\u06af\u06cc\u0646 \u0634\u062f\u0646\u062f\u061f",
