        {
          "title": "\u0646\u0645\u0627\u06cc\u0646\u062f\u0647 \u067e\u0627\u0631\u0644\u0645\u0627\u0646 \u0627\u0633\u062a\u0631\u0627\u0644\u06cc\u0627 \u062f\u0631 \u0634\u0631\u0627\u06cc\u0637 \u0628\u062d\u0631\u0627\u0646\u06cc \u067e\u0633 \u0627\u0632 \u00ab\u062d\u0645\u0644\u0647 \u0639\u0645\u062f\u06cc\u00bb \u0628\u0627 \u062e\u0648\u062f\u0631\u0648",
