          "title": "\u0622\u0645\u0631\u06cc\u06a9\u0627 \u0633\u0647 \u00ab\u0639\u0627\u0645\u0644 \u0627\u06cc\u0631\u0627\u0646\u06cc\u00bb \u0631\u0627 \u062f\u0631 \u0627\u0631\u062a\u0628\u0627\u0637 \u0628\u0627 \u0637\u0631\u062d\u06cc \u0639\u0644\u06cc\u0647 \u06cc\u06a9 \u067e\u0627\u06cc\u06af\u0627\u0647 \u0647\u0648\u0627\u06cc\u06cc \u062f\u0631 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0645\u062a\u0647\u0645 \u06a9\u0631\u062f",
