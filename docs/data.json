          "title": "\u0642\u06cc\u0645\u062a \u0646\u0641\u062a \u0628\u0647 \u0645\u0631\u0632 \u06f1\u06f1\u06f0 \u062f\u0644\u0627\u0631 \u0631\u0633\u06cc\u062f\u061b \u062a\u0631\u0627\u0645\u067e \u0628\u0633\u06cc\u0627\u0631\u06cc \u0627\u0632 \u062a\u062d\u0631\u06cc\u0645\u200c\u0647\u0627\u06cc \u062a\u0627\u0632\u0647 \u0631\u0648\u0633\u06cc\u0647 \u0631\u0627 \u062a\u0639\u0644\u06cc\u0642 \u06a9\u0631\u062f",
