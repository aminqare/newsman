          "title": "\u06cc\u06a9 \u0639\u0636\u0648 \u0627\u0631\u0634\u062f \u0627\u0631\u062a\u0634 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0647 \u0638\u0646 \u062c\u0627\u0633\u0648\u0633\u06cc \u0628\u0631\u0627\u06cc \u0631\u0648\u0633\u06cc\u0647 \u062f\u0631 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0628\u0627\u0632\u062f\u0627\u0634\u062a \u0634\u062f",
