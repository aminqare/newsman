        {
          "title": "\u067e\u0646\u062a\u0627\u06af\u0648\u0646 \u0646\u062e\u0633\u062a\u06cc\u0646 \u062a\u0635\u0648\u06cc\u0631 \u0648\u0627\u0636\u062d \u0627\u0632 \u0647\u0648\u0627\u067e\u06cc\u0645\u0627\u06cc \u0641\u0636\u0627\u06cc\u06cc \u0645\u062d\u0631\u0645\u0627\u0646\u0647 \u0686\u06cc\u0646 \u0631\u0627 \u0645\u0646\u062a\u0634\u0631 \u06a9\u0631\u062f",
