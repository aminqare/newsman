        {
          "title": "\u00ab\u0646\u0647 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646\u06cc\u0645\u060c \u0646\u0647 \u062f\u0631 \u0622\u0644\u0645\u0627\u0646\u00bb\u061b \u0628\u0644\u0627\u062a\u06a9\u0644\u06cc\u0641\u06cc \u0645\u062a\u0642\u0627\u0636\u06cc\u0627\u0646 \u0648\u06cc\u0632\u0627\u06cc \u0622\u0644\u0645\u0627\u0646 \u062f\u0631 \u0635\u0641 \u0633\u0641\u0627\u0631\u062a",
