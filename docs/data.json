          "title": "\u0627\u06af\u0631 \u067e\u0627\u067e \u0628\u06cc\u0645\u0627\u0631 \u0628\u0627\u0634\u062f\u060c \u0686\u0647 \u06a9\u0633\u06cc \u06a9\u0644\u06cc\u0633\u0627\u06cc \u06a9\u0627\u062a\u0648\u0644\u06cc\u06a9 \u0631\u0627 \u0627\u062f\u0627\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f\u061f",
