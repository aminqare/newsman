          "summary": "\u0646\u0631\u062e \u0627\u0631\u0632 \u0648 \u0637\u0644\u0627 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0627\u0632 \u0647\u0645 \u0631\u06a9\u0648\u0631\u062f \u0634\u06a9\u0633\u062a. \u0646\u06af\u0631\u0627\u0646\u06cc \u062f\u0631\u0628\u0627\u0631\u0647 \u062a\u0634\u062f\u06cc\u062f \u0641\u0634\u0627\u0631 \u0628\u0631 \u062a\u062c\u0627\u0631\u062a \u062e\u0627\u0631\u062c\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0628\u0627\u0639\u062b \u0634\u062f \u0642\u06cc\u0645\u062a \u0647\u0631 \u062f\u0644\u0627\u0631 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u0628\u0627\u0632\u0627\u0631 \u063a\u06cc\u0631\u0631\u0633\u0645\u06cc \u0628\u0627 \u062d\u062f\u0648\u062f \u0647\u0641\u062a \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646 \u0627\u0641\u0632\u0627\u06cc\u0634 \u062f\u0631 \u0645\u0642\u0637\u0639\u06cc \u0628\u0647 \u0628\u06cc\u0634 \u0627\u0632 \u06f2\u06f0\u06f0 \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646 \u0628\u0631\u0633\u062f. \u0642\u06cc\u0645\u062a \u0647\u0631 \u0633\u06a9\u0647 \u0637\u0631\u062d\u2026",
