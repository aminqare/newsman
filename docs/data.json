          "title": "\u0642\u0627\u0644\u06cc\u0628\u0627\u0641 \u062f\u0631\u0628\u0627\u0631\u0647 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0648\u0627\u0634\u0646\u06af\u062a\u0646: \u062a\u0631\u0627\u0645\u067e \u0646\u0642\u0636 \u0639\u0647\u062f \u06a9\u0631\u062f\u0647 \u0648 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0627\u06cc\u062f \u062a\u0646\u0628\u06cc\u0647 \u0634\u0648\u062f",
