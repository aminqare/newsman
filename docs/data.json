          "summary": "\u0647\u0644\u0646 \u0647\u06cc\u0646\u0632\u060c \u0646\u0645\u0627\u06cc\u0646\u062f\u0647 \u0645\u0633\u062a\u0642\u0644 \u067e\u0627\u0631\u0644\u0645\u0627\u0646 \u0627\u0633\u062a\u0631\u0627\u0644\u06cc\u0627\u060c \u0628\u0627 \u062e\u0648\u062f\u0631\u0648 \u0632\u06cc\u0631 \u06af\u0631\u0641\u062a\u0647 \u0648 \u062f\u0686\u0627\u0631 \u062c\u0631\u0627\u062d\u0627\u062a \u062c\u062f\u06cc \u0634\u062f\u0647 \u0627\u0633\u062a. \u0627\u0648 \u0628\u0627 \u0628\u0627\u0644\u06af\u0631\u062f \u0628\u0647 \u0628\u06cc\u0645\u0627\u0631\u0633\u062a\u0627\u0646 \u0645\u0646\u062a\u0642\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a. \u0622\u0646\u062a\u0648\u0646\u06cc \u0622\u0644\u0628\u0627\u0646\u06cc\u0632\u06cc\u060c \u0646\u062e\u0633\u062a\u200c\u0648\u0632\u06cc\u0631 \u0627\u0633\u062a\u0631\u0627\u0644\u06cc\u0627\u060c \u0622\u0646 \u0631\u0627 \u00ab\u06cc\u06a9 \u062d\u0645\u0644\u0647\u00bb \u062a\u0648\u0635\u06cc\u0641 \u06a9\u0631\u062f\u061b \u0627\u0648 \u0628\u0647 \u0634\u0628\u06a9\u0647 \u062f\u0648\u0644\u062a\u06cc \u0627\u0633\u062a\u0631\u0627\u0644\u06cc\u0627\u060c\u2026",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
