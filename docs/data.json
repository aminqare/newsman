          "title": "\u0686\u0631\u0627 \u0637\u0631\u0641\u200c\u0647\u0627\u06cc \u062f\u0631\u06af\u06cc\u0631 \u062f\u0631 \u06cc\u0645\u0646 \u0628\u0631\u0627\u06cc \u06a9\u0646\u062a\u0631\u0644 \u062a\u0639\u0632 \u0645\u06cc\u200c\u062c\u0646\u06af\u0646\u062f\u061f",
