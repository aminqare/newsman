          "title": "\ud83d\udd34 \u062a\u0648\u0627\u0641\u0642 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u0686\u06cc\u0646 \u0628\u0631 \u0639\u062f\u0645 \u062f\u0633\u062a\u06cc\u0627\u0628\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0647 \u0633\u0644\u0627\u062d \u0647\u0633\u062a\u0647\u200c\u0627\u06cc\u061b \u0628\u062d\u0631\u06cc\u0646 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0647\u0641\u062a \u0647\u0632\u0627\u0631 \u062d\u0645\u0644\u0647 \u0639\u0644\u06cc\u0647 \u0647\u0645\u0633\u0627\u06cc\u06af\u0627\u0646\u0634 \u0627\u0646\u062c\u0627\u0645 \u062f\u0627\u062f\u0647 \u0627\u0633\u062a",
