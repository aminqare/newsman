        {
          "title": "\u00ab\u0627\u0631\u0632\u0634\u200c\u0647\u0627\u06cc \u0633\u0646\u062a\u06cc\u00bb \u0648 \u0633\u0631\u06a9\u0648\u0628 \u062c\u0648\u0627\u0646\u0627\u0646\u061b \u067e\u0634\u062a \u06cc\u0648\u0631\u0634\u200c\u0647\u0627\u06cc \u067e\u0644\u06cc\u0633 \u0631\u0648\u0633\u06cc\u0647 \u0686\u0647 \u062e\u0628\u0631 \u0627\u0633\u062a\u061f",
