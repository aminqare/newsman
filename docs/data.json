        {
          "title": "\u062f\u0631 \u062a\u06cc\u0631\u0627\u0646\u062f\u0627\u0632\u06cc \u0645\u0631\u06af\u0628\u0627\u0631 \u062f\u0631 \u0645\u06cc\u062f\u0627\u0646 \u0627\u0635\u0644\u06cc \u06a9\u0631\u0627\u06a9\u0648\u0641 \u062f\u0631 \u0644\u0647\u0633\u062a\u0627\u0646 \u062a\u0639\u062f\u0627\u062f\u06cc \u06a9\u0634\u062a\u0647 \u0648 \u0645\u062c\u0631\u0648\u062d \u0634\u062f\u0646\u062f",
          "link": "https://www.bbc.com/persian/articles/cmn06dx9yn2zo?at_medium=RSS&at_campaign=rss",
          "summary": "\u200c\u067e\u0644\u06cc\u0633 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u067e\u06cc \u0648\u0642\u0648\u0639 \u062a\u06cc\u0631\u0627\u0646\u062f\u0627\u0632\u06cc \u062f\u0631 \u0645\u06cc\u062f\u0627\u0646 \u0627\u0635\u0644\u06cc \u0634\u0647\u0631 \u06a9\u0631\u0627\u06a9\u0648\u0641 \u0644\u0647\u0633\u062a\u0627\u0646\u060c \u067e\u0646\u062c \u0646\u0641\u0631 \u06a9\u0634\u062a\u0647 \u0648 \u062f\u0633\u062a\u06a9\u0645 \u06f1\u06f2 \u0646\u0641\u0631 \u062f\u06cc\u06af\u0631\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 \u0634\u0645\u0627\u0631\u06cc \u0627\u0632 \u0645\u0623\u0645\u0648\u0631\u0627\u0646 \u067e\u0644\u06cc\u0633\u060c \u0632\u062e\u0645\u06cc \u0634\u062f\u0647\u200c\u0627\u0646\u062f. \u0628\u0647 \u06af\u0641\u062a\u0647 \u0645\u0642\u0627\u0645\u0627\u062a \u062d\u0627\u0644 \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u062c\u0631\u0648\u062d\u0627\u0646 \u067e\u0644\u06cc\u0633 \u00ab\u0648\u062e\u06cc\u0645\u00bb \u06af\u0632\u0627\u0631\u0634 \u0634\u062f\u0647 \u0627\u0633\u062a.",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
          "source_url": "https://feeds.bbci.co.uk/persian/rss.xml"
        },
        {
          "title": "\u00ab\u062c\u0627\u06cc\u0632\u0647 \u0622\u0632\u0627\u062f\u06cc\u00bb \u0628\u0631\u0627\u06cc \u0645\u0631\u062f\u0645 \u0627\u06cc\u0631\u0627\u0646\u061b\u200c \u0686\u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0631\u0636\u0627 \u067e\u0647\u0644\u0648\u06cc \u0628\u0631\u0627\u06cc \u062f\u0631\u06cc\u0627\u0641\u062a \u0622\u0646 \u0628\u062d\u062b\u200c\u0628\u0631\u0627\u0646\u06af\u06cc\u0632 \u0634\u062f\u061f",
          "link": "https://www.bbc.com/persian/articles/cqpvgg070w8eo?at_medium=RSS&at_campaign=rss",
          "summary": "\u0628\u0646\u06cc\u0627\u062f \u0641\u0631\u062f\u0631\u06cc\u0634 \u0646\u0627\u0648\u0645\u0646 \u062c\u0627\u06cc\u0632\u0647 \u0622\u0632\u0627\u062f\u06cc \u0633\u0627\u0644 \u06f2\u06f0\u06f2\u06f6\u0631\u0627 \u0628\u0647 \u00ab\u0645\u0631\u062f\u0645 \u0627\u06cc\u0631\u0627\u0646\u00bb \u0627\u0647\u062f\u0627 \u06a9\u0631\u062f\u0647\u060c \u0627\u0645\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u0631\u0636\u0627 \u067e\u0647\u0644\u0648\u06cc \u0628\u0631\u0627\u06cc \u00ab\u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u0645\u0627\u0646\u06cc\u00bb \u0622\u0646\u060c \u0648\u0627\u06a9\u0646\u0634\u200c\u0647\u0627\u06cc \u0645\u0648\u0627\u0641\u0642 \u0648 \u0645\u062e\u0627\u0644\u0641 \u0648 \u0628\u062d\u062b\u200c\u0647\u0627\u06cc \u0632\u06cc\u0627\u062f\u06cc \u062f\u0631\u0628\u0627\u0631\u0647 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u06cc \u0645\u0631\u062f\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0631\u0627\u0646\u06af\u06cc\u062e\u062a\u0647 \u0627\u0633\u062a.",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
          "source_url": "https://feeds.bbci.co.uk/persian/rss.xml"
        },
        {
          "title": "\u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644 \u0645\u062a\u062d\u062f \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06a9\u0647 \u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f \u062a\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0627\u0645\u0633\u0627\u0644 \u00ab\u06f7\u06f0\u06f0 \u0645\u0631\u06a9\u0632 \u062f\u0631\u0645\u0627\u0646\u06cc\u00bb \u062f\u0631 \u0627\u0641\u063a\u0627\u0646\u0633\u062a\u0627\u0646 \u0628\u0633\u062a\u0647 \u0634\u0648\u062f",
          "link": "https://www.bbc.com/persian/articles/c9e8l5xx3jdgo?at_medium=RSS&at_campaign=rss",
          "summary": "\u0631\u0648\u0646\u0648 \u0644\u0645\u0627\u0631\u06a9\u06cc\u060c \u0645\u0639\u0627\u0648\u0646 \u0646\u0645\u0627\u06cc\u0646\u062f\u0647 \u0648\u06cc\u0698\u0647 \u0645\u0644\u0644 \u0645\u062a\u062d\u062f \u062f\u0631 \u0627\u0641\u063a\u0627\u0646\u0633\u062a\u0627\u0646\u060c \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06a9\u0647 \u0628\u0627 \u06a9\u0627\u0647\u0634 \u06a9\u0645\u06a9\u200c\u0647\u0627\u06cc \u0628\u0634\u0631\u062f\u0648\u0633\u062a\u0627\u0646\u0647 \u062f\u0631 \u06cc\u06a9 \u0633\u0627\u0644 \u0627\u062e\u06cc\u0631 \u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u06cc\u200c\u0631\u0648\u062f \u062a\u0627 \u00ab\u06f7\u06f0\u06f0 \u0645\u0631\u06a9\u0632 \u0635\u062d\u06cc\u00bb \u062a\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0633\u0627\u0644 \u06f2\u06f0\u06f2\u06f6 \u062f\u0631 \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631 \u062a\u0639\u0637\u06cc\u0644 \u0634\u0648\u0646\u062f. \u0628\u0647 \u0628\u0627\u0648\u0631 \u0627\u0648 \u0628\u0633\u062a\u0647 \u0634\u062f\u0646 \u0627\u06cc\u0646 \u0645\u0631\u0627\u06a9\u0632 \u0645\u0646\u062c\u0631 \u0628\u0647\u2026",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
          "source_url": "https://feeds.bbci.co.uk/persian/rss.xml"
        },
        {
          "title": "\u0634\u0634 \u0646\u0627\u0645\u0632\u062f \u0627\u06cc\u0631\u0627\u0646\u06cc \u062a\u0628\u0627\u0631 \u062f\u0631 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627\u061b \u0686\u0647\u0627\u0631 \u067e\u06cc\u0631\u0648\u0632\u060c \u06cc\u06a9 \u0634\u06a9\u0633\u062a \u0648 \u06cc\u06a9 \u0631\u0642\u0627\u0628\u062a \u0646\u0627\u062a\u0645\u0627\u0645",
          "link": "https://www.bbc.com/persian/articles/c6kgl724dje0o?at_medium=RSS&at_campaign=rss",
          "summary": "\u062f\u0631 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0645\u06cc\u0627\u0646\u200c\u062f\u0648\u0631\u0647\u200c\u0627\u06cc \u0633\u0648\u0645 \u0646\u0648\u0627\u0645\u0628\u0631 \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0634\u0634 \u0646\u0627\u0645\u0632\u062f \u0627\u06cc\u0631\u0627\u0646\u06cc \u062a\u0628\u0627\u0631 \u0628\u0631\u0627\u06cc \u0648\u0631\u0648\u062f \u06cc\u0627 \u0627\u062f\u0627\u0645\u0647 \u0641\u0639\u0627\u0644\u06cc\u062a \u062f\u0631 \u06a9\u0646\u06af\u0631\u0647 \u0648 \u0645\u062c\u0627\u0644\u0633 \u0642\u0627\u0646\u0648\u0646\u06af\u0630\u0627\u0631\u06cc \u0627\u06cc\u0627\u0644\u062a\u06cc \u0631\u0642\u0627\u0628\u062a \u06a9\u0631\u062f\u0646\u062f. \u0633\u0647 \u0646\u0641\u0631 \u0627\u0632 \u0622\u0646\u0647\u0627 \u0646\u0627\u0645\u0632\u062f \u0645\u062c\u0644\u0633 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u0627\u0646 \u0641\u062f\u0631\u0627\u0644 \u0648 \u0633\u0647 \u0646\u0641\u0631 \u0646\u0627\u0645\u0632\u062f \u0645\u062c\u0627\u0644\u0633 \u0627\u06cc\u0627\u0644\u062a\u06cc \u0628\u0648\u062f\u0646\u062f.",
