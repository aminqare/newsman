        {
          "title": "\u06cc\u062e\u0686\u0627\u0644 \u0648 \u0641\u0631\u06cc\u0632\u0631 \u0633\u0648\u067e\u0631\u0645\u0627\u0631\u06a9\u062a\u200c\u0647\u0627 \u062f\u0631 \u0647\u0641\u062a \u06a9\u0634\u0648\u0631 \u0627\u0631\u0648\u067e\u0627\u06cc\u06cc \u0647\u06a9 \u0634\u062f\u0646\u062f",
