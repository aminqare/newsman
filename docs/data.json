        {
          "title": "\ud83d\udd34 \u0631\u0648\u0628\u06cc\u0648: \u0628\u062f\u0648\u0646 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc\u060c \u062d\u0648\u062b\u06cc\u200c\u0647\u0627 \u062a\u0648\u0627\u0646 \u0628\u06cc\u200c\u062b\u0628\u0627\u062a\u06cc \u0645\u0646\u0637\u0642\u0647 \u0631\u0627 \u0646\u062f\u0627\u0634\u062a\u0646\u062f\u061b \u067e\u0631\u0632\u06cc\u062f\u0646\u062a \u062a\u0631\u0627\u0645\u067e: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u0631 \u0645\u0630\u0627\u06a9\u0631\u0627\u062a \u0686\u0646\u062f\u0627\u0646 \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0645\u0627\u062f \u0646\u06cc\u0633\u062a",
