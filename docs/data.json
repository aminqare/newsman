        {
          "title": "\u06a9\u0646\u0627\u0631\u0647\u200c\u06af\u06cc\u0631\u06cc \u0632\u0648\u062f\u0647\u0646\u06af\u0627\u0645 \u06a9\u06cc\u062a\u06cc \u0632\u06a9\u0631\u06cc\u0627\u061b \u0633\u062e\u0646\u06af\u0648\u06cc\u06cc \u06a9\u0647 \u062f\u0631 \u0631\u0648\u0632\u0647\u0627\u06cc \u062d\u0633\u0627\u0633 \u062a\u0631\u0627\u0645\u067e \u0646\u0627\u06a9\u0627\u0645 \u0645\u0627\u0646\u062f",
