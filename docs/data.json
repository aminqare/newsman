        {
          "title": "\u062f\u0648\u0631\u0647 \u062a\u0627\u0632\u0647 \u0627\u0639\u062a\u0631\u0627\u0636\u0627\u062a \u0633\u0631\u0627\u0633\u0631\u06cc \u062f\u0631 \u0641\u0631\u0627\u0646\u0633\u0647",
