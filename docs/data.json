          "title": "\u0645\u0647\u0631\u062f\u0627\u062f \u0627\u062e\u0644\u0627\u0642\u06cc \u0628\u0631\u0627\u06cc \u0648\u0632\u0627\u0631\u062a \u062f\u0641\u0627\u0639 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0632 \u0645\u062c\u0644\u0633 \u0631\u0627\u06cc \u0627\u0639\u062a\u0645\u0627\u062f \u06af\u0631\u0641\u062a",
