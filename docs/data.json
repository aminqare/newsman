        {
          "title": "\u062a\u0646\u0634 \u0645\u06cc\u0627\u0646 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648 \u0648 \u0645\u062e\u0627\u0644\u0641\u0627\u0646\u0634 \u062f\u0631 \u062c\u0644\u0633\u0647 \u0633\u0648\u06af\u0646\u062f \u067e\u0627\u0631\u0644\u0645\u0627\u0646 \u062c\u062f\u06cc\u062f \u0627\u0633\u0631\u0627\u0626\u06cc\u0644",
