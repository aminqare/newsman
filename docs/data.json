          "title": "\u0648\u0627\u0698\u06af\u0648\u0646\u06cc \u0627\u062a\u0648\u0628\u0648\u0633 \u062f\u0631 \u0627\u06cc\u0644\u0627\u0645\u061b \u062a\u062c\u0645\u0639 \u0627\u0639\u062a\u0631\u0627\u0636\u06cc \u062f\u0631 \u0622\u0628\u062f\u0627\u0646\u0627\u0646",
