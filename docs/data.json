          "title": "\ud83d\udd34 \u0647\u0634\u062f\u0627\u0631 \u067e\u0631\u0632\u06cc\u062f\u0646\u062a \u062a\u0631\u0627\u0645\u067e \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u062d\u062a\u0645\u0627\u0644 \u062d\u0645\u0644\u0647 \u0628\u0627 \u00ab\u0628\u0645\u0628 \u06a9\u062b\u06cc\u0641\u00bb: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0647\u0627\u06cc\u06cc \u0628\u06cc\u200c\u0633\u0627\u0628\u0642\u0647 \u062e\u0648\u0627\u0647\u062f \u067e\u0631\u062f\u0627\u062e\u062a",
