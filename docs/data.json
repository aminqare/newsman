        {
          "title": "\u00ab\u062f\u0631\u0648\u0627\u0632\u0647 \u0622\u0647\u0646\u06cc\u0646\u00bb\u061b \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062a\u0627 \u0686\u0647 \u0627\u0646\u062f\u0627\u0632\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u062a\u0627\u0645\u06cc\u0646 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u0645\u062e\u062a\u0644 \u06a9\u0646\u062f\u061f",
