        {
          "title": "\u0634\u0647\u0631\u06cc \u06a9\u0647 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u0622\u0646 \u0631\u0627 \u0645\u06cc\u200c\u06af\u0631\u062f\u0627\u0646\u062f\u061b \u0648\u0642\u062a\u06cc \u0627\u0646\u0633\u0627\u0646\u200c\u0647\u0627 \u0646\u06af\u0627\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646\u062f \u0622\u0646\u0647\u0627 \u0686\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061f",
