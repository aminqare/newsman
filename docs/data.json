        {
          "title": "\u0627\u062e\u0644\u0627\u0644 \u06af\u0633\u062a\u0631\u062f\u0647 \u062f\u0631 \u0686\u0646\u062f\u06cc\u0646 \u0641\u0631\u0648\u062f\u06af\u0627\u0647 \u0645\u0646\u0627\u0637\u0642 \u0634\u0631\u0642\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u067e\u06cc \u0642\u0637\u0639 \u062a\u0635\u0627\u062f\u0641\u06cc \u06cc\u06a9 \u06a9\u0627\u0628\u0644 \u0641\u06cc\u0628\u0631 \u0646\u0648\u0631\u06cc",
