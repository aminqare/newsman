          "title": "\ud83d\udd34 \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627 \u0627\u0632 \u062d\u0645\u0644\u0647 \u062f\u0641\u0627\u0639\u06cc \u0648 \u0645\u062d\u062f\u0648\u062f \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0647 \u0627\u0647\u062f\u0627\u0641\u06cc \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646\u061b \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e: \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0645\u062c\u0628\u0648\u0631 \u0634\u0648\u06cc\u0645 \u0633\u0631\u0627\u063a \u062a\u0627\u0633\u06cc\u0633\u0627\u062a \u00ab\u06a9\u0648\u0647 \u06a9\u0644\u0646\u06af\u00bb \u0628\u0631\u0648\u06cc\u0645",
          "link": "https://ir.voanews.com/a/8217207.html",
          "summary": "\u062e\u0628\u0631\u06af\u0632\u0627\u0631\u06cc \u0622\u0633\u0648\u0634\u06cc\u062a\u062f\u067e\u0631\u0633 \u0634\u0627\u0645\u06af\u0627\u0647 \u062f\u0648\u0634\u0646\u0628\u0647 \u0628\u0647 \u0646\u0642\u0644 \u0627\u0632 \u06cc\u06a9 \u0645\u0642\u0627\u0645 \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u06af\u0632\u0627\u0631\u0634 \u062f\u0627\u062f \u06a9\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062d\u0645\u0644\u0627\u062a \u062f\u0641\u0627\u0639\u06cc \u0645\u062d\u062f\u0648\u062f\u06cc \u0631\u0627 \u0639\u0644\u06cc\u0647 \u0628\u0631\u062e\u06cc \u0627\u0647\u062f\u0627\u0641 \u0627\u06cc\u0631\u0627\u0646\u06cc \u062f\u0631 \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632 \u0627\u0646\u062c\u0627\u0645 \u062f\u0627\u062f\u0647 \u0627\u0633\u062a. \u0631\u0626\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0646\u06cc\u0632 \u062f\u0648\u0634\u0646\u0628\u0647 \u0634\u0628 \u062f\u0631 \u06af\u0641\u062a\u200c\u0648\u06af\u0648 \u0628\u0627 \u0641\u0627\u06a9\u0633\u200c\u0646\u06cc\u0648\u0632 \u0628\u0627\u0631 \u062f\u06cc\u06af\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
