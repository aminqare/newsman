          "title": "\u0633\u0627\u0632\u0646\u062f\u0647 \u0686\u062a \u062c\u06cc\u200c\u067e\u06cc\u200c\u062a\u06cc \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0628\u0627\u062a\u200c\u0647\u0627\u06cc \u0627\u0648\u067e\u0646\u200c\u0627\u06cc\u200c\u0622\u06cc \u0628\u0647 \u0648\u0628\u200c\u0633\u0627\u06cc\u062a\u200c \u0646\u0647\u0627\u062f\u0647\u0627\u06cc \u062f\u0648\u0644\u062a\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0646\u0641\u0648\u0630 \u06a9\u0631\u062f\u0646\u062f",
