        {
          "title": "\u06a9\u0627\u0631\u0632\u0627\u0631 \u00ab\u062e\u0627\u0646\u0648\u0627\u062f\u0647\u200c\u0627\u0645 \u062f\u0631 \u0627\u0645\u0627\u0646 \u0627\u0633\u062a\u00bb\u061b \u0686\u0631\u0627 \u0645\u0646\u062a\u0642\u062f\u0627\u0646 \u0627\u0632 \u00ab\u0627\u0639\u0644\u0627\u0646 \u062c\u0646\u06af \u0639\u0644\u06cc\u0647 \u0647\u0645\u062c\u0646\u0633\u200c\u06af\u0631\u0627\u06cc\u06cc\u00bb \u062f\u0631 \u062a\u0631\u06a9\u06cc\u0647 \u0645\u06cc\u200c\u06af\u0648\u06cc\u0646\u062f\u061f",
