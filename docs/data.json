          "title": "\u0648\u0646\u0633: \u062a\u0631\u0627\u0645\u067e \u0627\u062c\u0627\u0632\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f \u062f\u0631\u06af\u06cc\u0631\u06cc \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0647 \u00ab\u062c\u0646\u06af\u06cc \u0628\u06cc\u200c\u067e\u0627\u06cc\u0627\u0646\u00bb \u062a\u0628\u062f\u06cc\u0644 \u0634\u0648\u062f",
