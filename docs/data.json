          "summary": "\u0631\u0626\u06cc\u0633 \u0645\u062c\u0644\u0633 \u0627\u06cc\u0631\u0627\u0646 \u0648 \u0645\u0630\u0627\u06a9\u0631\u0647 \u06a9\u0646\u0646\u062f\u0647 \u0627\u0631\u0634\u062f \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631 \u06af\u0641\u062a\u0647 \u0627\u0633\u062a \u00ab\u0627\u0633\u0631\u0627\u0626\u06cc\u0644\u06cc\u200c\u0647\u0627 \u0628\u0631\u0627\u06cc \u06a9\u0634\u0627\u0646\u062f\u0646 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0647 \u062c\u0646\u06af\u06cc \u0628\u06cc\u200c\u067e\u0627\u06cc\u0627\u0646 \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646 \u062a\u0644\u0627\u0634 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f.\u00bb \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e\u060c \u0631\u0626\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631 \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0628\u0639\u062f \u0627\u0632 \u062f\u06cc\u062f\u0627\u0631 \u0628\u0627 \u0646\u062e\u0633\u062a\u200c\u0648\u0632\u06cc\u0631 \u0642\u0637\u0631 \u06af\u0641\u062a \u06a9\u0647 \u0642\u0637\u0631 \u0648 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0633\u0639\u0648\u062f\u06cc \u062e\u0648\u2026",
