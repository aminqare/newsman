          "summary": "\u0628\u0631\u0627\u06cc \u0642\u0631\u0646\u200c\u0647\u0627\u060c \u0646\u0627\u0645 \u06a9\u0648\u0644\u0648\u0631 \u0628\u0627 \u0627\u0644\u0645\u0627\u0633 \u06af\u0631\u0647 \u062e\u0648\u0631\u062f\u0647 \u0628\u0648\u062f\u061b \u0631\u0648\u0633\u062a\u0627\u06cc\u06cc \u062f\u0631 \u062c\u0646\u0648\u0628 \u0647\u0646\u062f \u06a9\u0647 \u0628\u0633\u06cc\u0627\u0631\u06cc \u0627\u0632 \u0645\u0648\u0631\u062e\u0627\u0646 \u0622\u0646 \u0631\u0627 \u0632\u0627\u062f\u06af\u0627\u0647 \u0627\u062d\u062a\u0645\u0627\u0644\u06cc \u0627\u0644\u0645\u0627\u0633 \u0627\u0641\u0633\u0627\u0646\u0647\u200c\u0627\u06cc \u00ab\u06a9\u0648\u0647 \u0646\u0648\u0631\u00bb \u0645\u06cc\u200c\u062f\u0627\u0646\u0646\u062f. \u0627\u06af\u0631\u0686\u0647 \u0627\u06cc\u0646 \u0631\u0648\u0633\u062a\u0627 \u0633\u0627\u0644\u200c\u0647\u0627 \u067e\u06cc\u0634 \u0632\u06cc\u0631 \u0622\u0628 \u0631\u0641\u062a\u060c \u0627\u0645\u0627 \u062f\u0627\u0633\u062a\u0627\u0646 \u0622\u0646 \u0647\u0646\u0648\u0632 \u067e\u0627\u06cc\u0627\u0646 \u0646\u06cc\u0627\u0641\u062a\u0647 \u0627\u0633\u062a.\u2026",
