        {
          "title": "\u0627\u0632 \u0639\u0631\u0648\u0633 \u0627\u06cc\u062a\u0627\u0644\u06cc\u0627\u06cc\u06cc \u062a\u0627 \u0642\u062f\u0631\u062a\u0645\u0646\u062f\u062a\u0631\u06cc\u0646 \u0632\u0646 \u0633\u06cc\u0627\u0633\u062a \u0647\u0646\u062f\u061b \u06a9\u062a\u0627\u0628 \u062e\u0627\u0637\u0631\u0627\u062a \u0633\u0648\u0646\u06cc\u0627 \u06af\u0627\u0646\u062f\u06cc\u061b \u0631\u0648\u0627\u06cc\u062a\u06cc \u0627\u0632 \u0639\u0634\u0642\u060c \u0642\u062f\u0631\u062a \u0648 \u0641\u0642\u062f\u0627\u0646",
