          "title": "\u062a\u0631\u0627\u0645\u067e: \u0642\u0637\u0631 \u0648 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u062e\u0648\u0627\u0647\u0627\u0646 \u0631\u0627\u0647\u200c\u062d\u0644\u06cc \u0645\u0633\u0627\u0644\u0645\u062a\u200c\u0622\u0645\u06cc\u0632 \u0628\u0631\u0627\u06cc \u062c\u0646\u06af \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646 \u0647\u0633\u062a\u0646\u062f",
