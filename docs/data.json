        {
          "title": "\u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u0631\u0648\u0633\u06cc\u0647 \u0628\u0631\u0627\u06cc \u0645\u06cc\u0627\u0646\u062c\u06cc\u06af\u0631\u06cc\u061b \u067e\u0648\u062a\u06cc\u0646 \u062f\u0631 \u062c\u0646\u06af \u0627\u06cc\u0631\u0627\u0646 \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u0686\u06cc\u0633\u062a\u061f",
