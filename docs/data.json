        {
          "title": "\u062a\u0631\u0627\u0645\u067e \u0648 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648 \u062f\u0631 \u06cc\u06a9 \u0633\u0646\u06af\u0631\u061b \u0633\u0627\u06cc\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0631 \u062f\u0648 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0633\u0631\u0646\u0648\u0634\u062a\u200c\u0633\u0627\u0632",
