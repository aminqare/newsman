        {
          "title": "\u062a\u0631\u06a9\u06cc\u0647 \u0628\u0647 \u0631\u0642\u0627\u0628\u062a \u062f\u0628\u06cc\u0631\u06a9\u0644\u06cc \u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644 \u067e\u06cc\u0648\u0633\u062a\u061b \u0641\u0631\u06cc\u062f\u0648\u0646 \u0633\u06cc\u0646\u06cc\u0631\u0644\u06cc\u200c\u0627\u0648\u063a\u0644\u0648 \u0686\u0647 \u0634\u0627\u0646\u0633\u06cc \u062f\u0627\u0631\u062f\u061f",
          "link": "https://www.bbc.com/persian/articles/cqy0r6yn4xwdo?at_medium=RSS&at_campaign=rss",
          "summary": "\u062f\u0648\u0631\u0647 \u062f\u0628\u06cc\u0631\u06a9\u0644\u06cc \u0622\u0646\u062a\u0648\u0646\u06cc\u0648 \u06af\u0648\u062a\u0631\u0634\u060c \u062f\u0628\u06cc\u0631\u06a9\u0644 \u0633\u0627\u0632\u0645\u0627\u0646 \u0645\u0644\u0644 \u0645\u062a\u062d\u062f\u060c \u06f3\u06f1 \u062f\u0633\u0627\u0645\u0628\u0631 \u06f2\u06f0\u06f2\u06f6 \u0628\u0647 \u067e\u0627\u06cc\u0627\u0646 \u0645\u06cc\u200c\u0631\u0633\u062f \u0648 \u062a\u0631\u06a9\u06cc\u0647 \u0646\u06cc\u0632 \u0628\u0647 \u0631\u0642\u0627\u0628\u062a \u0628\u0631\u0627\u06cc \u0627\u0646\u062a\u062e\u0627\u0628 \u062c\u0627\u0646\u0634\u06cc\u0646 \u0627\u0648 \u067e\u06cc\u0648\u0633\u062a\u0647 \u0627\u0633\u062a. \u062a\u0631\u06a9\u06cc\u0647 \u06a9\u0647 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u06f3\u06f1 \u0627\u06a9\u062a\u0628\u0631 \u0646\u0627\u0645\u0632\u062f\u06cc \u062e\u0648\u062f \u0631\u0627 \u062b\u0628\u062a \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a\u060c \u0631\u0648\u06cc \u0641\u0631\u06cc\u062f\u0648\u0646 \u0633\u06cc\u0646\u06cc\u0631\u0644\u06cc\u200c\u0627\u0648\u063a\u0644\u0648\u060c\u2026",
