        {
          "title": "\u0622\u06cc\u0646\u062f\u0647 \u0632\u0646\u0627\u0646 \u062c\u0646\u06af\u062c\u0648\u06cc \u06a9\u0631\u062f \u062f\u0631 \u0633\u0648\u0631\u06cc\u0647 \u0686\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f\u061f",
