        {
          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u062a\u0646\u0647\u0627 \u062f\u0644\u06cc\u0644\u06cc \u06a9\u0647 \u0647\u0646\u0648\u0632 \u06a9\u0627\u0631\u0645\u0627\u0646 \u0631\u0627 \u0628\u0627 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062a\u0645\u0627\u0645 \u0646\u06a9\u0631\u062f\u06cc\u0645 \u0627\u06cc\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645 \u0645\u0647\u0631\u0628\u0627\u0646 \u0628\u0627\u0634\u0645\u061b \u0627\u0645\u0627 \u062f\u0631 \u0645\u0642\u0637\u0639\u06cc \u0645\u062c\u0628\u0648\u0631\u06cc\u0645 \u0636\u0631\u0628\u0647 \u0686\u06a9\u0634 \u0631\u0627 \u0628\u0632\u0646\u06cc\u0645",
