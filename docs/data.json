        {
          "title": "\u0633\u067e\u0627\u0647 \u067e\u0627\u0633\u062f\u0627\u0631\u0627\u0646 \u0645\u0633\u062a\u0642\u06cc\u0645 \u0628\u0627 \u0645\u062e\u0627\u0637\u0628 \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u0633\u062e\u0646 \u06af\u0641\u062a\u061b \u062f\u0644\u06cc\u0644 \u0627\u06cc\u0646 \u062a\u0635\u0645\u06cc\u0645 \u0686\u06cc\u0633\u062a\u061f",
