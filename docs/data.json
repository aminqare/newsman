        {
          "title": "\u0631\u0627\u0632\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0647 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u06af\u0641\u062a\u0647\u200c\u0627\u06cc\u062f\u060c \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0631\u0648\u0632\u06cc \u0641\u0631\u0648\u062e\u062a\u0647 \u0634\u0648\u0646\u062f",
