        {
          "title": "\u062f\u0648 \u0633\u0627\u0644 \u067e\u0633 \u0627\u0632 \u0627\u0646\u0641\u062c\u0627\u0631 \u067e\u06cc\u062c\u0631\u0647\u0627 \u062f\u0631 \u0644\u0628\u0646\u0627\u0646\u061b \u0632\u062e\u0645\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0647\u0646\u0648\u0632 \u0627\u0644\u062a\u06cc\u0627\u0645 \u0646\u06cc\u0627\u0641\u062a\u0647\u200c\u0627\u0646\u062f",
