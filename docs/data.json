        {
          "title": "\u067e\u0631\u0648\u0627\u0632 \u06f9\u06f0\u06f1\u061b \u0645\u0639\u0645\u0627\u06cc \u0647\u0648\u0627\u067e\u06cc\u0645\u0627\u06cc\u06cc \u06a9\u0647 \u062f\u0631 \u0622\u0633\u0645\u0627\u0646 \u0645\u0646\u0641\u062c\u0631 \u0634\u062f",
