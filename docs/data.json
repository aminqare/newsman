        {
          "title": "\u0628\u062d\u0631\u0627\u0646 \u0633\u06cc\u0627\u0633\u06cc \u0641\u0631\u06cc\u062f\u0631\u06cc\u0634 \u0645\u0631\u062a\u0633\u061b \u0622\u06cc\u0627 \u0641\u0631\u0647\u0646\u06af \u062b\u0628\u0627\u062a \u0633\u06cc\u0627\u0633\u06cc \u062f\u0631 \u0622\u0644\u0645\u0627\u0646 \u062f\u0631 \u062e\u0637\u0631 \u0627\u0633\u062a\u061f",
