          "summary": "\u062e\u0628\u0631\u06af\u0632\u0627\u0631\u06cc \u0631\u0648\u06cc\u062a\u0631\u0632 \u0648 \u0686\u0646\u062f \u0631\u0633\u0627\u0646\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0645\u06cc\u200c\u06af\u0648\u06cc\u0646\u062f \u06a9\u0647 \u06cc\u06a9 \u0647\u06cc\u0626\u062a \u0642\u0637\u0631\u06cc \u0628\u0647 \u0631\u06cc\u0627\u0633\u062a \u0645\u0634\u0627\u0648\u0631 \u0627\u0631\u0634\u062f \u0646\u062e\u0633\u062a\u200c\u0648\u0632\u06cc\u0631 \u0627\u06cc\u0646 \u06a9\u0634\u0648\u0631\u060c \u0633\u0627\u0639\u062a\u06cc \u067e\u06cc\u0634 \u0648\u0627\u0631\u062f \u062a\u0647\u0631\u0627\u0646 \u0634\u062f\u0647 \u0627\u0633\u062a. \u0628\u0646\u0627\u0628\u0631 \u0627\u06cc\u0646 \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627\u060c \u0627\u06cc\u0646 \u0647\u06cc\u0626\u062a \u0628\u0644\u0646\u062f\u067e\u0627\u06cc\u0647 \u0642\u0637\u0631\u06cc \u0628\u0627 \u0639\u0628\u0627\u0633 \u0639\u0631\u0627\u0642\u0686\u06cc \u062f\u06cc\u062f\u0627\u0631 \u0648 \u0631\u0627\u06cc\u0632\u0646\u06cc \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f. \u0627\u062f\u0627\u0645\u0647\u2026",
