        {
          "title": "\u0634\u0627\u06cc\u0639\u0647 \u067e\u0627\u06cc\u0627\u0646 \u062f\u0646\u06cc\u0627 \u062f\u0631 \u06f1\u06f3 \u0646\u0648\u0627\u0645\u0628\u0631 \u06f2\u06f0\u06f2\u06f6 \u0627\u0632 \u06a9\u062c\u0627 \u0622\u0645\u062f\u0647 \u0627\u0633\u062a\u061f",
