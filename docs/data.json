          "title": "\u062f\u0647\u200c\u0647\u0627 \u06a9\u0634\u062a\u0647 \u062f\u0631 \u0627\u0646\u0641\u062c\u0627\u0631 \u0645\u0633\u062c\u062f \u062f\u0631 \u062f\u0627\u062e\u0644 \u0645\u0642\u0631 \u0642\u062f\u06cc\u0645\u06cc \u067e\u0644\u06cc\u0633 \u062f\u0631 \u067e\u0627\u06a9\u0633\u062a\u0627\u0646",
