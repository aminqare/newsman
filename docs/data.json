          "title": "\u00ab\u0645\u0627 \u0634\u0645\u0627 \u0631\u0627 \u062a\u0646\u0647\u0627 \u06af\u0630\u0627\u0634\u062a\u06cc\u0645\u00bb\u061b \u0631\u0648\u0627\u06cc\u062a \u0698\u0646\u0631\u0627\u0644\u200c\u0647\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u0627\u0632 \u0632\u0645\u0633\u062a\u0627\u0646 \u0633\u062e\u062a \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646",
