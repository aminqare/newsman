      "items": [
        {
          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u062a\u0646\u0647\u0627 \u062f\u0644\u06cc\u0644\u06cc \u06a9\u0647 \u0647\u0646\u0648\u0632 \u06a9\u0627\u0631\u0645\u0627\u0646 \u0631\u0627 \u0628\u0627 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062a\u0645\u0627\u0645 \u0646\u06a9\u0631\u062f\u06cc\u0645 \u0627\u06cc\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645 \u0645\u0647\u0631\u0628\u0627\u0646 \u0628\u0627\u0634\u0645\u061b \u0627\u0645\u0627 \u062f\u0631 \u0645\u0642\u0637\u0639\u06cc \u0645\u062c\u0628\u0648\u0631\u06cc\u0645 \u0636\u0631\u0628\u0647 \u0686\u06a9\u0634 \u0631\u0627 \u0628\u0632\u0646\u06cc\u0645",
          "link": "https://ir.voanews.com/a/8217207.html",
          "summary": "\u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e\u060c \u0631\u0626\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u06cc\u06a9\u0634\u0646\u0628\u0647 \u06f1\u06f0 \u0622\u0628\u0627\u0646 \u062f\u0631 \u06cc\u06a9 \u0633\u062e\u0646\u0631\u0627\u0646\u06cc \u062f\u0631 \u0627\u06cc\u0627\u0644\u062a \u0622\u06cc\u0648\u0648\u0627 \u06af\u0641\u062a \u00ab\u062a\u0646\u0647\u0627 \u062f\u0644\u06cc\u0644\u06cc \u06a9\u0647 \u0647\u0646\u0648\u0632 \u06a9\u0627\u0631\u0645\u0627\u0646 \u0631\u0627 \u0628\u0627 [\u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc] \u0627\u06cc\u0631\u0627\u0646 \u062a\u0645\u0627\u0645 \u0646\u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u0645\u060c \u0627\u06cc\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645 \u0645\u0647\u0631\u0628\u0627\u0646 \u0628\u0627\u0634\u0645. \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u0645 \u0627\u06af\u0631 \u0628\u062a\u0648\u0627\u0646\u0645 \u062c\u0627\u0646 \u0647\u0645\u0647 \u0622\u0646 \u0627\u0646\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
          "source_url": "https://ir.voanews.com/api/zbtpil-vomx-tpeqiyp"
        },
        {
          "title": "\ud83d\udd34 \u067e\u0631\u0632\u06cc\u062f\u0646\u062a \u062a\u0631\u0627\u0645\u067e: \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0627\u0632 \u0633\u0627\u0644 \u06f1\u06f3\u06f5\u06f7 \u062c\u0646\u06af \u0628\u0627 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0631\u0627 \u0622\u063a\u0627\u0632 \u06a9\u0631\u062f\u061b \u062a\u0627\u06a9\u06cc\u062f \u0641\u0631\u0645\u0627\u0646\u062f\u0647 \u0633\u0646\u062a\u06a9\u0627\u0645 \u0628\u0631 \u0628\u0627\u0632 \u0628\u0648\u062f\u0646 \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u0627\u0635\u0644\u06cc \u06a9\u0634\u062a\u06cc\u0631\u0627\u0646\u06cc \u062f\u0631 \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632",
          "link": "https://ir.voanews.com/a/8214778.html",
