        {
          "title": "\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0631\u06cc\u0627\u0633\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0628\u0631\u0632\u06cc\u0644\u061b \u0634\u0645\u0627\u0631\u0634 \u0622\u0631\u0627 \u0622\u063a\u0627\u0632 \u0634\u062f\u060c \u0628\u0648\u0644\u0633\u0646\u0627\u0631\u0648 \u067e\u06cc\u0634\u062a\u0627\u0632 \u0631\u0642\u0627\u0628\u062a \u0628\u0633\u06cc\u0627\u0631 \u0646\u0632\u062f\u06cc\u06a9 \u062f\u0631 \u0645\u0631\u062d\u0644\u0647 \u0627\u0648\u0644",
