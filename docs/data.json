          "summary": "\u0622\u06cc\u0627 \u062c\u0647\u0627\u0646 \u062f\u0631 \u06f1\u06f3 \u0646\u0648\u0627\u0645\u0628\u0631 \u06f2\u06f0\u06f2\u06f6 \u0628\u0647 \u067e\u0627\u06cc\u0627\u0646 \u0645\u06cc\u200c\u0631\u0633\u062f\u061f \u0627\u06cc\u0646 \u067e\u0631\u0633\u0634\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0628\u0627 \u0646\u0632\u062f\u06cc\u06a9 \u0634\u062f\u0646 \u0628\u0647 \u0627\u06cc\u0646 \u062a\u0627\u0631\u06cc\u062e \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u062f\u0631 \u0634\u0628\u06a9\u0647\u200c\u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc \u0645\u0637\u0631\u062d \u0634\u062f\u0647 \u0627\u0633\u062a. \u0627\u0633\u062a\u0646\u0627\u062f \u0627\u0635\u0644\u06cc \u0627\u06cc\u0646 \u0631\u0648\u0627\u06cc\u062a \u0628\u0647 \u067e\u0698\u0648\u0647\u0634\u06cc \u0639\u0644\u0645\u06cc \u062f\u0631 \u0633\u0627\u0644 \u06f1\u06f9\u06f6\u06f0 \u0628\u0627\u0632\u0645\u06cc\u200c\u06af\u0631\u062f\u062f \u06a9\u0647 \u0628\u0627 \u0639\u0646\u0648\u0627\u0646 \u062c\u0646\u062c\u0627\u0644\u06cc \u00ab\u0631\u0648\u0632 \u0642\u06cc\u0627\u0645\u062a\u2026",
