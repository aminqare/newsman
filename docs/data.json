        {
          "title": "\u0642\u0648\u0647 \u0642\u0636\u0627\u0626\u06cc\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06cc\u06a9 \u00ab\u0639\u0636\u0648\u00bb \u062c\u06cc\u0634\u200c\u0627\u0644\u0639\u062f\u0644 \u0631\u0627 \u0627\u0639\u062f\u0627\u0645 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a",
          "link": "https://www.bbc.com/persian/articles/cm79p802j2dpo?at_medium=RSS&at_campaign=rss",
          "summary": "\u0642\u0648\u0647 \u0642\u0636\u0627\u0626\u06cc\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06a9\u0647 \u0631\u0648\u0632 \u062f\u0648\u0634\u0646\u0628\u0647 \u06cc\u06a9 \u00ab\u0639\u0636\u0648\u00bb \u06af\u0631\u0648\u0647 \u062c\u06cc\u0634\u200c\u0627\u0644\u0639\u062f\u0644 \u0631\u0627 \u0627\u0639\u062f\u0627\u0645 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a. \u0645\u06cc\u0632\u0627\u0646\u060c \u062e\u0628\u0631\u06af\u0632\u0627\u0631\u06cc \u0642\u0648\u0647 \u0642\u0636\u0627\u0626\u06cc\u0647\u060c \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06a9\u0647 \u0639\u0645\u0631 \u062f\u0631\u0633\u062a\u0627\u0631\u0627\u0646 \u0628\u0647 \u0627\u062a\u0647\u0627\u0645 \u00ab\u0628\u063a\u06cc\u00bb (\u0642\u06cc\u0627\u0645 \u0645\u0633\u0644\u062d\u0627\u0646\u0647) \u0648 \u0639\u0636\u0648\u06cc\u062a \u062f\u0631 \u062c\u06cc\u0634\u200c\u0627\u0644\u0639\u062f\u0644 \u0645\u062d\u0627\u06a9\u0645\u0647 \u0648 \u0628\u0647 \u0627\u0639\u062f\u0627\u0645 \u0645\u062d\u06a9\u0648\u0645 \u0634\u062f\u0647 \u0628\u0648\u062f. \u0628\u2026",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
          "source_url": "https://feeds.bbci.co.uk/persian/rss.xml"
        },
        {
          "title": "\u062a\u062d\u0631\u06cc\u0645 \u0631\u0627\u0647\u200c\u0622\u0647\u0646 \u0627\u06cc\u0631\u0627\u0646\u061b \u0641\u0634\u0627\u0631 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0631 \u06a9\u0631\u06cc\u062f\u0648\u0631\u0647\u0627\u06cc \u0632\u0645\u06cc\u0646\u06cc \u0686\u0647 \u0627\u062b\u0631\u06cc \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a\u061f",
          "link": "https://www.bbc.com/persian/articles/ckg5jy2pvmdro?at_medium=RSS&at_campaign=rss",
          "summary": "\u062a\u062d\u0631\u06cc\u0645 \u0631\u0627\u0647\u200c\u0622\u0647\u0646 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646 \u0635\u0631\u0641\u0627 \u062a\u062d\u0631\u06cc\u0645 \u0633\u0647 \u0634\u0631\u06a9\u062a \u062d\u0645\u0644\u200c\u0648\u0646\u0642\u0644 \u062f\u0627\u0646\u0633\u062a. \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0627 \u0647\u062f\u0641 \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u0646 \u0634\u0628\u06a9\u0647 \u0631\u06cc\u0644\u06cc\u060c \u06cc\u06a9\u06cc \u0627\u0632 \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc\u06cc \u0631\u0627 \u0646\u0634\u0627\u0646\u0647 \u06af\u0631\u0641\u062a\u0647 \u06a9\u0647 \u062f\u0631 \u0645\u0627\u0647\u200c\u0647\u0627\u06cc \u0627\u062e\u06cc\u0631 \u0648 \u0647\u0645\u0632\u0645\u0627\u0646 \u0628\u0627 \u0645\u062d\u062f\u0648\u062f \u0634\u062f\u0646 \u0631\u0627\u0647\u200c\u0647\u0627\u06cc \u062f\u0631\u06cc\u0627\u06cc\u06cc \u0648 \u0647\u0648\u0627\u06cc\u06cc\u060c \u0646\u0642\u0634 \u067e\u0631\u0631\u0646\u06af\u200c\u062a\u0631\u06cc \u062f\u0631 \u062d\u0641\u0638\u2026",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
