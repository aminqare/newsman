        {
          "title": "\ud83d\udd34 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648: \u0648\u0642\u062a \u0622\u0646 \u0631\u0633\u06cc\u062f\u0647 \u062a\u0647\u062f\u06cc\u062f \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0631\u0627 \u00ab\u06cc\u06a9 \u0628\u0627\u0631 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647\u00bb \u0627\u0632 \u0645\u06cc\u0627\u0646 \u0628\u0631\u062f\u0627\u0631\u06cc\u0645\u061b \u0639\u0628\u0648\u0631 \u06f1.\u06f7 \u0645\u06cc\u0644\u06cc\u0627\u0631\u062f \u0628\u0634\u06a9\u0647 \u0646\u0641\u062a \u0627\u0632 \u0647\u0631\u0645\u0632 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0633\u0646\u062a\u06a9\u0627\u0645",
          "link": "https://ir.voanews.com/a/iran-usa-world-news-live-coverage/8223624.html",
          "summary": "\u0646\u062e\u0633\u062a\u200c\u0648\u0632\u06cc\u0631 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u0628\u0627 \u0627\u0633\u062a\u0646\u0627\u062f \u0628\u0647 \u062a\u0644\u0627\u0634 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062e\u0648\u062f \u06af\u0641\u062a \u06a9\u0647 \u0632\u0645\u0627\u0646 \u0622\u0646 \u0631\u0633\u06cc\u062f\u0647 \u0627\u0633\u062a \u062a\u0627 \u062a\u0647\u062f\u06cc\u062f \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u00ab\u06cc\u06a9 \u0628\u0627\u0631 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647\u00bb \u0627\u0632 \u0645\u06cc\u0627\u0646 \u0628\u0631\u062f\u0627\u0634\u062a\u0647 \u0634\u0648\u062f. \u062f\u0631 \u062e\u0628\u0631\u06cc \u062f\u06cc\u06af\u0631\u060c \u0633\u0646\u062a\u06a9\u0627\u0645\u060c \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u06a9\u0647 \u0628\u06cc\u0634 \u0627\u0632 \u06f1.\u06f7 \u0645\u06cc\u2026",
