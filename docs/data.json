        {
          "title": "\u0686\u0631\u0627 \u0642\u0647\u0648\u0647 \u0631\u0648\u06cc \u0628\u0639\u0636\u06cc\u200c\u0647\u0627 \u0627\u062b\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0631\u0648\u06cc \u0628\u0639\u0636\u06cc \u062f\u06cc\u06af\u0631 \u0646\u0647\u061f",
