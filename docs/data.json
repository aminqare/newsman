        {
          "title": "\u0639\u0644\u06cc \u0632\u06cc\u062f\u06cc \u0628\u0647 \u0648\u0632\u0627\u0631\u062a \u0646\u0641\u062a \u062f\u0633\u062a\u0648\u0631 \u062f\u0627\u062f \u06a9\u0646\u062a\u0631\u0644 \u0645\u06cc\u0627\u062f\u06cc\u0646 \u0646\u0641\u062a\u06cc \u0627\u0642\u0644\u06cc\u0645 \u06a9\u0631\u062f\u0633\u062a\u0627\u0646 \u0639\u0631\u0627\u0642 \u0631\u0627 \u0628\u0647 \u062f\u0633\u062a \u0628\u06af\u06cc\u0631\u062f",
