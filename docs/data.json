        {
          "title": "\u062d\u06a9\u0648\u0645\u062a \u0633\u0627\u0644\u0645\u0646\u062f\u0627\u0646\u061b \u0686\u0631\u0627 \u062c\u0648\u0627\u0646\u0627\u0646 \u0628\u0647 \u0633\u06cc\u0627\u0633\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0631\u0627\u0647 \u067e\u06cc\u062f\u0627 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061f",
