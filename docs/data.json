        {
          "title": "\ud83d\udd34 \u0647\u0634\u062f\u0627\u0631 \u0648\u0632\u06cc\u0631 \u062c\u0646\u06af \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0647 \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646: \u06cc\u0627 \u0627\u0632 \u062c\u0627\u0647\u200c\u0637\u0644\u0628\u06cc \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062f\u0633\u062a \u0628\u06a9\u0634\u06cc\u062f \u06cc\u0627 \u0628\u0627 \u062d\u0645\u0644\u0627\u062a \u0648\u06cc\u0631\u0627\u0646\u06af\u0631 \u0631\u0648\u0628\u0647\u200c\u0631\u0648 \u0634\u0648\u06cc\u062f",
