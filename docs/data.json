          "summary": "\u067e\u0633 \u0627\u0632 \u0622\u0646\u200c\u06a9\u0647 \u0645\u0634\u062e\u0635 \u0634\u062f \u067e\u0627\u067e \u0644\u0626\u0648\u0646 \u0686\u0647\u0627\u0631\u062f\u0647\u0645 \u0628\u0647 \u0633\u0631\u0637\u0627\u0646 \u0631\u06cc\u0647 \u0645\u0628\u062a\u0644\u0627\u0633\u062a\u060c \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u0647\u0645\u0627\u0646 \u067e\u0631\u0633\u0634\u06cc \u0645\u0637\u0631\u062d \u0634\u062f \u06a9\u0647 \u0647\u0646\u06af\u0627\u0645 \u0628\u0633\u062a\u0631\u06cc \u0634\u062f\u0646 \u0633\u0644\u0641 \u0627\u0648\u060c \u067e\u0627\u067e \u0641\u0631\u0627\u0646\u0633\u06cc\u0633\u060c \u062f\u0631 \u0645\u0627\u0631\u0633 \u0633\u0627\u0644 \u06af\u0630\u0634\u062a\u0647 \u0630\u0647\u0646 \u0628\u0633\u06cc\u0627\u0631\u06cc \u0631\u0627 \u0628\u0647 \u062e\u0648\u062f \u0645\u0634\u063a\u0648\u0644 \u06a9\u0631\u062f\u0647 \u0628\u0648\u062f: \u062d\u0627\u0644\u0627 \u0686\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f\u061f",
