        {
          "title": "\u0631\u0627\u0632 \u0628\u0642\u0627\u06cc \u06a9\u0647\u0646\u200c\u062a\u0631\u06cc\u0646 \u062a\u0645\u062f\u0646 \u0622\u0645\u0631\u06cc\u06a9\u0627\u061b \u0633\u0627\u0632\u06af\u0627\u0631\u06cc \u0628\u0647 \u062c\u0627\u06cc \u062c\u0646\u06af",
