        {
          "title": "\u0627\u0639\u062a\u0631\u0627\u0641 \u067e\u0633 \u0627\u0632 \u06f1\u06f3 \u0633\u0627\u0644\u061b \u0632\u0646\u06cc \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0634\u0631\u06cc\u06a9 \u0632\u0646\u062f\u06af\u06cc\u200c\u0627\u0634 \u062f\u0631 \u062e\u0648\u0627\u0628 \u0628\u0647 \u0627\u0648 \u062a\u062c\u0627\u0648\u0632 \u0645\u06cc\u200c\u06a9\u0631\u062f",
