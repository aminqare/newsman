        {
          "title": "\u00ab\u0639\u0635\u0631 \u06a9\u0631\u0627\u0648\u0627\u062a \u0628\u0647 \u0633\u0631 \u0622\u0645\u062f\u0647\u00bb\u061b \u0633\u06cc\u0627\u0633\u062a\u0645\u062f\u0627\u0631\u0627\u0646 \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u0686\u06af\u0648\u0646\u0647 \u0628\u0627 \u0644\u0628\u0627\u0633 \u0631\u0627\u06cc \u062c\u0645\u0639 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061f",
