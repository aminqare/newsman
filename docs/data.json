        {
          "title": "\u062d\u0645\u0627\u06cc\u062a \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0627\u0632 \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646\u061b \u0631\u0648\u0633\u06cc\u0647: \u0631\u0648\u0627\u0628\u0637 \u0645\u0633\u06a9\u0648 \u0648 \u0644\u0646\u062f\u0646 \u0628\u0647 \u0634\u06a9\u0644\u06cc \u0628\u06cc\u200c\u0633\u0627\u0628\u0642\u0647 \u062a\u06cc\u0631\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a",
