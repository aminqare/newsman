        {
          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u062f\u0627\u0631\u06cc\u0645 \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u062d\u0627\u0635\u0644 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0647\u0631\u06af\u0632 \u0628\u0647 \u0633\u0644\u0627\u062d \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062f\u0633\u062a \u067e\u06cc\u062f\u0627 \u0646\u06a9\u0646\u062f\u061b \u062f\u0644\u0627\u0631 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0647 \u0628\u06cc\u0634 \u0627\u0632 \u06f2\u06f7\u06f4 \u0647\u0632\u0627\u0631 \u062a\u0648\u0645\u0627\u0646 \u0631\u0633\u06cc\u062f",
          "link": "https://ir.voanews.com/a/8212243.html",
