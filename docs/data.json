        {
          "title": "\u0627\u0641\u0632\u0627\u06cc\u0634 \u0634\u062f\u06cc\u062f \u0642\u06cc\u0645\u062a \u062f\u0644\u0627\u0631 \u0648 \u0637\u0644\u0627 \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0647\u0645\u0632\u0645\u0627\u0646 \u0628\u0627 \u0646\u06af\u0631\u0627\u0646\u06cc \u0627\u0632 \u0641\u0634\u0627\u0631 \u0627\u0642\u062a\u0635\u0627\u062f\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
