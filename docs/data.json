        {
          "title": "\u062f\u0648 \u06a9\u0634\u0648\u0631\u060c \u062f\u0648 \u0627\u0639\u062a\u0631\u0627\u0636\u061b \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u062d\u06a9\u0648\u0645\u062a\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0627\u0639\u062a\u0631\u0627\u0636\u0627\u062a \u0641\u0631\u0627\u0646\u0633\u0647 \u0648 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u0686\u06af\u0648\u0646\u0647 \u0645\u0642\u0627\u06cc\u0633\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061f",
          "link": "https://www.bbc.com/persian/articles/cmkgk1k6pgz7o?at_medium=RSS&at_campaign=rss",
          "summary": "\u0627\u0639\u062a\u0631\u0627\u0636\u0627\u062a \u0627\u062e\u06cc\u0631 \u0641\u0631\u0627\u0646\u0633\u0647 \u0628\u0647 \u0645\u0648\u0636\u0648\u0639 \u0645\u0642\u0627\u06cc\u0633\u0647 \u0646\u062d\u0648\u0647 \u0628\u0631\u062e\u0648\u0631\u062f \u062d\u06a9\u0648\u0645\u062a\u200c\u0647\u0627\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0648 \u0641\u0631\u0627\u0646\u0633\u0647 \u0628\u0627 \u0645\u0639\u062a\u0631\u0636\u0627\u0646 \u062a\u0628\u062f\u06cc\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a. \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0646\u0632\u062f\u06cc\u06a9 \u0628\u0647 \u062d\u06a9\u0648\u0645\u062a \u0627\u06cc\u0631\u0627\u0646 \u0628\u0627 \u062a\u0627\u06a9\u06cc\u062f \u0628\u0631 \u0646\u0642\u0634 \u0639\u0648\u0627\u0645\u0644 \u062e\u0627\u0631\u062c\u06cc \u0648 \u062e\u0634\u0648\u0646\u062a \u0645\u0639\u062a\u0631\u0636\u0627\u0646\u060c \u062a\u0644\u0627\u0634 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f \u0631\u0648\u0627\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u0627\u0632 \u0627\u0639\u062a\u0631\u0627\u0636\u0627\u062a \u062f\u06cc\u200c\u0645\u0627\u2026",
          "source": "BBC &#8238;\u0641\u0627\u0631\u0633\u06cc",
