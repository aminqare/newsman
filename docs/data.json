          "summary": "\u0644\u06cc \u062c\u0647\u200c\u0645\u06cc\u0648\u0646\u06af\u060c \u0631\u0626\u06cc\u0633 \u062c\u0645\u0647\u0648\u0631 \u06a9\u0631\u0647\u200c\u062c\u0646\u0648\u0628\u06cc \u06af\u0641\u062a \u06a9\u0647 \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u0646\u0638\u0627\u0645\u06cc\u200c\u200c\u0627\u0634 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0645\u0634\u0627\u0631\u06a9\u062a \u062f\u0631 \u062c\u0646\u06af \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646\u060c \u0627\u0639\u0632\u0627\u0645 \u0646\u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f. \u062f\u0631 \u0645\u0627\u0647\u200c\u0647\u0627\u06cc \u06af\u0630\u0634\u062a\u0647 \u06af\u0645\u0627\u0646\u0647\u200c\u0632\u0646\u06cc\u200c\u0647\u0627 \u0645\u0637\u0631\u062d \u0634\u062f\u0647 \u0628\u0648\u062f \u06a9\u0647 \u06a9\u0631\u0647 \u062c\u0646\u0648\u0628\u06cc \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062f\u0631 \u0647\u0645\u06a9\u0627\u0631\u06cc \u0628\u0627 \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0628\u0647 \u0639\u0645\u0644\u06cc\u0627\u062a \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u06a9\u0634\u062a\u06cc\u200c\u2026",
