        {
          "title": "\u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648 \u0627\u0632 \u06cc\u06a9 \u00ab\u063a\u0627\u0641\u0644\u06af\u06cc\u0631\u06cc \u0628\u0632\u0631\u06af \u0628\u0631\u0627\u06cc \u062a\u0634\u06a9\u06cc\u0644\u0627\u062a \u0641\u0644\u0633\u0637\u06cc\u0646\u06cc\u00bb \u062e\u0628\u0631 \u062f\u0627\u062f",
