          "title": "\u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u06cc \u0647\u0631\u0645\u0632\u06af\u0627\u0646: \u062d\u0645\u0644\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0628\u0647 \u0642\u0634\u0645 \u062e\u0633\u0627\u0631\u062a\u06cc \u0646\u062f\u0627\u0634\u062a",
