          "title": "\u0627\u0632 \u00ab\u062f\u06cc\u0648\u0627\u0631 \u0622\u0647\u0646\u06cc\u0646\u00bb \u062a\u0627 \u00ab\u0641\u0647\u0631\u0633\u062a \u0633\u0641\u06cc\u062f \u06a9\u06cc\u0641\u0631\u06cc\u00bb\u061b \u0686\u0647 \u0686\u06cc\u0632\u0647\u0627\u06cc\u06cc \u0642\u0631\u0627\u0631 \u0627\u0633\u062a \u062f\u0631 \u0637\u0631\u062d \u0646\u0641\u0648\u0630 \u062c\u0631\u0645 \u0634\u0648\u062f\u061f",
