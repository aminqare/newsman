        {
          "title": "\ud83d\udd34 \u067e\u0631\u0632\u06cc\u062f\u0646\u062a \u062a\u0631\u0627\u0645\u067e: \u0628\u0627\u06cc\u062f \u062f\u0631 \u0645\u0648\u0631\u062f \u0627\u06cc\u0631\u0627\u0646 \u062a\u0635\u0645\u06cc\u0645 \u0628\u06af\u06cc\u0631\u0645\u061b \u0648\u0632\u06cc\u0631 \u0627\u0646\u0631\u0698\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627: \u062c\u0647\u0627\u0646 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u06cc\u06a9 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0645\u062c\u0647\u0632 \u0628\u0647 \u0633\u0644\u0627\u062d \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u0631\u0627 \u062a\u062d\u0645\u0644 \u06a9\u0646\u062f",
          "link": "https://ir.voanews.com/a/iran-us-related-live-news-coverage/8162914.html",
          "summary": "\u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e\u060c \u0631\u0626\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0631\u0648\u0632 \u0634\u0646\u0628\u0647 \u06af\u0641\u062a: \u00ab\u0645\u0627 \u062a\u0635\u0645\u06cc\u0645\u06cc \u062f\u0627\u0631\u06cc\u0645 \u06a9\u0647 \u0628\u0627\u06cc\u062f \u062f\u0631\u0628\u0627\u0631\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0628\u06af\u06cc\u0631\u0645. [\u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc] \u0627\u06cc\u0631\u0627\u0646 \u0628\u0647 \u0634\u062f\u062a \u0622\u0633\u06cc\u0628 \u062f\u06cc\u062f\u0647 \u0648 \u062f\u0631\u0647\u0645\u200c\u0634\u06a9\u0633\u062a\u0647 \u0627\u0633\u062a\u061b \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646 \u062a\u0646\u0647\u0627 \u067e\u0631\u0633\u0634 \u0627\u06cc\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0622\u06cc\u0627 \u06a9\u0627\u0631 \u0627\u0632 \u0631\u0627\u0647 \u0622\u0633\u0627\u0646 \u067e\u06cc\u0634 \u062e\u0648\u0627\u0647\u062f \u0631\u0641\u062a \u06cc\u0627 \u0631\u0627\u0647\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
