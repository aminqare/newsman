          "summary": "\u0648\u0632\u06cc\u0631 \u062f\u0641\u0627\u0639 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u062a\u0644\u0627\u0634 \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u06cc\u0636\u0627\u062d \u0627\u0648 \u062f\u0631 \u06a9\u0646\u06af\u0631\u0647 \u062f\u0631 \u0631\u0627\u0628\u0637\u0647 \u0628\u0627 \u062c\u0646\u06af \u0627\u06cc\u0631\u0627\u0646 \u0627\u0642\u062f\u0627\u0645\u06cc \u00ab\u0645\u0636\u062d\u06a9\u00bb \u0627\u0633\u062a \u06a9\u0647 \u0634\u06a9\u0633\u062a \u062e\u0648\u0627\u0647\u062f \u062e\u0648\u0631\u062f. \u06cc\u06a9 \u0646\u0645\u0627\u06cc\u0646\u062f\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc\u200c\u062e\u0648\u0627\u0647 \u062f\u06cc\u0631\u0648\u0632 \u0637\u0631\u062d \u0627\u0633\u062a\u06cc\u0636\u0627\u062d \u067e\u06cc\u062a \u0647\u06af\u0633\u062a \u0631\u0627 \u0628\u0647 \u06a9\u0646\u06af\u0631\u0647 \u0627\u0631\u0627\u0626\u0647 \u062f\u0627\u062f. \u0622\u0642\u0627\u06cc \u0647\u06af\u0633\u062a \u062f\u0631 \u06a9\u0646\u0641\u0631\u0627\u0646\u0633 \u062e\u0628\u0631\u06cc \u06af\u0641\u062a \u06a9\u2026",
