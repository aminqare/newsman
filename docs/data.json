        {
          "title": "\u0627\u062d\u0636\u0627\u0631 \u0633\u0641\u06cc\u0631 \u0627\u06cc\u0631\u0627\u0646 \u062f\u0631 \u0644\u0646\u062f\u0646\u061b \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u062a\u0647\u062f\u06cc\u062f\u0647\u0627 \u062f\u0631 \u062e\u0627\u06a9\u0634 \u0631\u0627 \u062a\u062d\u0645\u0644 \u0646\u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f",
