        {
          "title": "\ud83d\udd34 \u0631\u0648\u0628\u06cc\u0648 \u062f\u0631 \u0645\u0648\u0631\u062f \u0631\u0648\u062d\u0627\u0646\u06cc\u0648\u0646 \u0634\u06cc\u0639\u0647 \u062d\u0627\u06a9\u0645 \u0628\u0631 \u0627\u06cc\u0631\u0627\u0646: \u062f\u0647\u200c\u0647\u0627 \u0647\u0632\u0627\u0631 \u0646\u0641\u0631 \u0627\u0632 \u0645\u0631\u062f\u0645 \u0645\u0639\u062a\u0631\u0636 \u062e\u0648\u062f \u0631\u0627 \u06a9\u0634\u062a\u0646\u062f\u061b \u0627\u06af\u0631 \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u0634\u0648\u0646\u062f \u0628\u0627 \u062f\u06cc\u06af\u0631\u0627\u0646 \u0686\u0647 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u061f",
