          "title": "\u0622\u0645\u0631\u06cc\u06a9\u0627 \u0648 \u06f2\u06f8 \u0645\u062a\u062d\u062f\u0634 \u0628\u0647 \u0627\u06cc\u0631\u0627\u0646 \u062f\u0631\u0628\u0627\u0631\u0647 \u00ab\u0627\u0642\u062f\u0627\u0645\u0627\u062a \u062e\u0635\u0645\u0627\u0646\u0647 \u062f\u0631 \u0642\u0644\u0645\u0631\u0648\u0634\u0627\u0646\u00bb \u0647\u0634\u062f\u0627\u0631 \u062f\u0627\u062f\u0646\u062f",
