          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0631\u0627\u06cc \u0633\u0627\u062e\u062a \u067e\u0647\u067e\u0627\u062f \u0645\u0634\u06a9\u0644 \u0628\u0631\u0642 \u062f\u0627\u0631\u062f\u061b \u0628\u0633\u0646\u062a \u0628\u0627 \u0627\u0634\u0627\u0631\u0647 \u0628\u0647 \u0622\u062b\u0627\u0631 \u0639\u0645\u0644\u06cc\u0627\u062a \u0637\u0631\u062f \u0627\u0642\u062a\u0635\u0627\u062f\u06cc: \u0641\u0631\u0645\u0627\u0646\u062f\u0647\u0627\u0646 \u0633\u067e\u0627\u0647 \u0647\u0645 \u0646\u06af\u0631\u0627\u0646 \u0641\u0631\u0648\u067e\u0627\u0634\u06cc \u0634\u062f\u0647\u200c\u0627\u0646\u062f",
