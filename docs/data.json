          "title": "\ud83d\udd34  \u0645\u062c\u0644\u0633 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u0627\u0646 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0637\u0631\u062d \u062a\u062d\u0631\u06cc\u0645\u200c\u0647\u0627\u06cc \u06af\u0633\u062a\u0631\u062f\u0647 \u0639\u0644\u06cc\u0647 \u0631\u0648\u0633\u06cc\u0647 \u0648 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0631\u0627 \u062a\u0635\u0648\u06cc\u0628 \u06a9\u0631\u062f\u061b \u062a\u0631\u0627\u0645\u067e: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0642\u0627\u062f\u0631 \u0628\u0647 \u0627\u062f\u0627\u0645\u0647 \u0648\u0636\u0639\u06cc\u062a \u06a9\u0646\u0648\u0646\u06cc \u0646\u06cc\u0633\u062a",
          "link": "https://ir.voanews.com/a/iran-us-related-live-news-coverage/8162914.html",
          "summary": "\u0645\u062c\u0644\u0633 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u0627\u0646 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0631\u0648\u0632 \u0686\u0647\u0627\u0631\u0634\u0646\u0628\u0647 \u0637\u0631\u062d \u062a\u062d\u0631\u06cc\u0645\u200c\u0647\u0627\u06cc \u06af\u0633\u062a\u0631\u062f\u0647 \u0628\u0631 \u0631\u0648\u0633\u06cc\u0647 \u0648 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u062a\u0635\u0648\u06cc\u0628 \u06a9\u0631\u062f. \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e\u060c \u0631\u0626\u064a\u0633\u200c\u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u06cc\u06a9 \u0633\u062e\u0646\u0631\u0627\u0646\u06cc \u062f\u0631 \u06a9\u0627\u0631\u0648\u0644\u06cc\u0646\u0627\u06cc \u0634\u0645\u0627\u0644\u06cc \u0628\u0627 \u0627\u0634\u0627\u0631\u0647 \u0628\u0647 \u0622\u0633\u06cc\u0628\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062f\u06cc\u062f\u0647 \u0627\u0633\u062a \u06af\u0641\u062a\u2026",
