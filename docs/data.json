        {
          "title": "\u0631\u0627\u0632 \u0645\u0627\u0646\u062f\u06af\u0627\u0631\u06cc \u0633\u0631\u0645\u0647\u061b \u0645\u06cc\u0631\u0627\u062b\u06cc \u06a9\u0647 \u0647\u0632\u0627\u0631\u0627\u0646 \u0633\u0627\u0644 \u062f\u0648\u0627\u0645 \u0622\u0648\u0631\u062f\u0647 \u0627\u0633\u062a",
