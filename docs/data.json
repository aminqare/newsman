        {
          "title": "\u0633\u0641\u0631 \u0627\u0639\u0644\u0627\u0645\u200c\u0646\u0634\u062f\u0647 \u0645\u06a9\u0631\u0648\u0646 \u0628\u0647 \u0631\u06cc\u0627\u0636 \u0648 \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627 \u0627\u0632 \u062d\u0645\u0644\u0647 \u062d\u0648\u062b\u06cc\u200c\u0647\u0627 \u0628\u0647 \u0639\u062f\u0646",
