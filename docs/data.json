        {
          "title": "\u062f\u0631 \u0635\u0648\u0631\u062a \u067e\u06cc\u0631\u0648\u0632\u06cc \u062f\u0631 \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a\u060c \u062d\u0632\u0628 \u0627\u0635\u0644\u0627\u062d \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0648\u0639\u062f\u0647 \u062f\u0627\u062f \u0646\u0638\u0627\u0645 \u067e\u0646\u0627\u0647\u0646\u062f\u06af\u06cc \u06a9\u0634\u0648\u0631 \u0631\u0627 \u062a\u0627 \u067e\u0646\u062c \u0633\u0627\u0644 \u062a\u0639\u0644\u06cc\u0642 \u06a9\u0646\u062f",
          "link": "https://www.bbc.com/persian/articles/c3pwgdleq5qko?at_medium=RSS&at_campaign=rss",
          "summary": "\u062d\u0632\u0628 \u0627\u0635\u0644\u0627\u062d \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 (\u0631\u0641\u0631\u0645 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627) \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u0635\u0648\u0631\u062a \u0628\u0647 \u0642\u062f\u0631\u062a \u0631\u0633\u06cc\u062f\u0646\u060c \u0646\u0638\u0627\u0645 \u067e\u0646\u0627\u0647\u0646\u062f\u06af\u06cc \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0631\u0627 \u0628\u0631\u0627\u06cc \u06cc\u06a9 \u062f\u0648\u0631\u0647 \u06a9\u0627\u0645\u0644 \u067e\u0627\u0631\u0644\u0645\u0627\u0646 \u062a\u0639\u0637\u06cc\u0644 \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f. \u0627\u06cc\u0646 \u062d\u0632\u0628 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f \u06a9\u0647 \u062a\u0645\u0627\u0645 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u200c\u0647\u0627\u06cc \u067e\u0646\u0627\u0647\u0646\u062f\u06af\u06cc \u062c\u062f\u06cc\u062f \u0631\u0627 \u0631\u062f \u0648 \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u200c\u0647\u0627\u06cc \u0645\u0648\u2026",
