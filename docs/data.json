        {
          "title": "\u062a\u0647\u062f\u06cc\u062f \u0628\u0647 \u0628\u0645\u0628\u200c\u06af\u0630\u0627\u0631\u06cc \u067e\u0631\u0648\u0627\u0632\u0647\u0627\u06cc \u0627\u0631\u0648\u067e\u0627\u06cc\u06cc\u060c \u062f\u0648\u0628\u0627\u0631\u0647 \u0628\u0627\u0639\u062b \u0641\u0631\u0648\u062f \u0627\u0636\u0637\u0631\u0627\u0631\u06cc \u0648 \u062a\u063a\u06cc\u06cc\u0631 \u0645\u0633\u06cc\u0631 \u067e\u0631\u0648\u0627\u0632\u0647\u0627 \u0634\u062f",
