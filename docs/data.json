          "summary": "\u0648\u0632\u06cc\u0631 \u062e\u0627\u0631\u062c\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06a9\u0647 \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e \u0647\u0646\u0648\u0632 \u062f\u0631 \u0645\u0648\u0631\u062f \u062d\u0645\u0644\u0627\u062a \u062a\u0627\u0632\u0647 \u0628\u0647 \u0627\u06cc\u0631\u0627\u0646 \u062a\u0635\u0645\u06cc\u0645 \u0646\u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a. \u0645\u0627\u0631\u06a9\u0648 \u0631\u0648\u0628\u06cc\u0648 \u06af\u0641\u062a \u06a9\u0647 \u0648\u0627\u0634\u0646\u06af\u062a\u0646 \u0647\u0646\u0648\u0632 \u06af\u0632\u06cc\u0646\u0647 \u062f\u06cc\u067e\u0644\u0645\u0627\u0633\u06cc \u0631\u0627 \u062f\u0631 \u0646\u0638\u0631 \u062f\u0627\u0631\u062f. \u0647\u0645\u0632\u0645\u0627\u0646 \u0631\u0626\u06cc\u0633 \u0633\u062a\u0627\u062f\u06a9\u0644 \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u0645\u0633\u0644\u062d \u0627\u06cc\u0631\u0627\u0646 \u06af\u0641\u062a\u0647 \u0627\u0633\u062a \u00ab\u0647\u0631\u06af\u0627\u0647 \u0646\u0634\u0627\u0646\u0647\u200c\u0647\u0627\u06cc\u2026",
