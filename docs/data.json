          "title": "\u00ab\u0641\u06cc\u0644\u06cc\u0646\u00bb\u060c \u0645\u0648\u0634\u06a9 \u062c\u062f\u06cc\u062f \u0631\u0648\u0633\u06cc\u0647\u061b \u0686\u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646 \u062e\u0637\u0631\u0646\u0627\u06a9 \u0627\u0633\u062a\u061f",
