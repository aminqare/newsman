          "title": "\u0639\u0631\u0627\u0642 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u0645\u0639\u0627\u0641\u06cc\u062a \u0627\u0632 \u062a\u062d\u0631\u06cc\u0645\u200c \u067e\u0631\u0648\u0627\u0632\u0647\u0627\u06cc \u0627\u06cc\u0631\u0627\u0646\u06cc \u0627\u0633\u062a\u061b \u062a\u0631\u0627\u0645\u067e \u0637\u0631\u062d \u0647\u0641\u062a\u200c\u0631\u0648\u0632\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0631\u0627 \u00ab\u0631\u062f \u06a9\u0631\u062f\u00bb",
