        {
          "title": "\u0622\u06cc\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0648\u0644\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0646\u06af\u0627\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc\u200c\u0647\u0627 \u0628\u0647 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u0631\u0627 \u0639\u0648\u0636 \u06a9\u0646\u062f\u061f",
