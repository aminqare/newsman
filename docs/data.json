        {
          "title": "\u00ab\u0627\u0648 \u06cc\u06a9 \u0641\u0631\u0634\u062a\u0647 \u0646\u062c\u0627\u062a \u0627\u0633\u062a\u00bb\u061b \u0632\u0646\u06cc \u06a9\u0647 \u0647\u0631 \u0647\u0641\u062a\u0647 \u06f1\u06f0 \u0647\u0632\u0627\u0631 \u062f\u0644\u0627\u0631 \u0628\u0631\u0627\u06cc \u06a9\u0648\u062f\u06a9\u0627\u0646 \u0645\u0647\u0627\u062c\u0631 \u0628\u0627\u0632\u062f\u0627\u0634\u062a\u200c\u0634\u062f\u0647 \u0645\u06cc\u200c\u0641\u0631\u0633\u062a\u062f",
