        {
          "title": "\u067e\u0648\u062a\u06cc\u0646 \u062f\u0631 \u062f\u06cc\u062f\u0627\u0631 \u0628\u0627 \u0648\u06cc\u062a\u06a9\u0627\u0641: \u0631\u0648\u0627\u0628\u0637 \u0645\u0627 \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0631 \u067e\u0627\u06cc\u0647 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0633\u062a\u060c \u0622\u0645\u0627\u062f\u0647\u200c\u0627\u06cc\u0645 \u0628\u0631\u0627\u06cc \u062d\u0644 \u0628\u062d\u0631\u0627\u0646 \u06a9\u0645\u06a9 \u06a9\u0646\u06cc\u0645",
