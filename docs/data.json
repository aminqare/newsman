        {
          "title": "\u0622\u06cc\u0627 \u0634\u06a9\u0627\u0641 \u0645\u06cc\u0627\u0646 \u062d\u0627\u06a9\u0645\u0627\u0646 \u0648 \u0645\u0631\u062f\u0645 \u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0630\u0631\u0628\u0627\u06cc\u062c\u0627\u0646 \u0639\u0645\u06cc\u0642\u200c\u062a\u0631 \u0634\u062f\u0647 \u0627\u0633\u062a\u061f",
