          "summary": "\u062c\u06cc\u200c\u062f\u06cc \u0648\u0646\u0633\u060c \u0645\u0639\u0627\u0648\u0646 \u0631\u0626\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631 \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u06af\u0641\u062a\u0647 \u0627\u0633\u062a \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e \u0627\u062c\u0627\u0632\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f \u062f\u0631\u06af\u06cc\u0631\u06cc \u0646\u0638\u0627\u0645\u06cc \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646 \u0628\u0647 \u06cc\u06a9 \u00ab\u062c\u0646\u06af \u0628\u06cc\u200c\u067e\u0627\u06cc\u0627\u0646\u00bb \u062a\u0628\u062f\u06cc\u0644 \u0634\u0648\u062f. \u0627\u0648 \u062f\u0631 \u062f\u0641\u0627\u0639 \u0627\u0632 \u0633\u06cc\u0627\u0633\u062a \u0646\u0638\u0627\u0645\u06cc \u062f\u0648\u0644\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u062e\u0627\u0648\u0631\u0645\u06cc\u0627\u0646\u0647 \u062a\u0623\u06a9\u06cc\u062f \u06a9\u0631\u062f \u06a9\u0647 \u0645\u062e\u0627\u0644\u0641\u062a \u0628\u0627 \u062c\u0646\u06af\u200c\u0647\u0627\u06cc \u0637\u0648\u0644\u0627\u0646\u06cc\u200c\u0645\u2026",
