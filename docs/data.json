        {
          "title": "\u0622\u0645\u0627\u062f\u0647\u200c\u0628\u0627\u0634 \u0648\u0627\u0634\u0646\u06af\u062a\u0646 \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u0627\u06cc\u0631\u0627\u0646\u061b \u0627\u0632 \u0647\u0634\u062f\u0627\u0631 \u062f\u0631\u0628\u0627\u0631\u0647 \u0637\u0631\u062d\u200c\u0647\u0627\u06cc \u062a\u0631\u0648\u0631 \u062a\u0627 \u0628\u0631\u0631\u0633\u06cc \u062d\u0645\u0644\u0627\u062a \u062a\u0627\u0632\u0647",
          "link": "https://www.bbc.com/persian/articles/cwx28d1j6d4yo?at_medium=RSS&at_campaign=rss",
          "summary": "\u062f\u0631 \u062d\u0627\u0644\u06cc \u06a9\u0647 \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e \u0628\u0627\u0631 \u062f\u06cc\u06af\u0631 \u0627\u0632 \u0627\u062d\u062a\u0645\u0627\u0644 \u062d\u0645\u0644\u0647 \u0646\u0638\u0627\u0645\u06cc \u0628\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0633\u062e\u0646 \u06af\u0641\u062a\u0647 \u0627\u0633\u062a\u060c \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627\u06cc \u062a\u0627\u0632\u0647 \u0631\u0633\u0627\u0646\u0647\u200c\u0647\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627\u06cc\u06cc \u0627\u0632 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0646\u06af\u0631\u0627\u0646\u06cc \u0648\u0627\u0634\u0646\u06af\u062a\u0646 \u062f\u0631\u0628\u0627\u0631\u0647 \u067e\u06cc\u0627\u0645\u062f\u0647\u0627\u06cc \u062f\u0648\u0631 \u062c\u062f\u06cc\u062f \u062c\u0646\u06af \u062d\u06a9\u0627\u06cc\u062a \u062f\u0627\u0631\u0646\u062f. \u0627\u06a9\u0633\u06cc\u0648\u0633 \u0627\u0632 \u06cc\u06a9 \u0647\u0634\u062f\u0627\u0631 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631\u0628\u0627\u0631\u0647\u2026",
