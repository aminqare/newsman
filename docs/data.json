          "title": "\ud83d\udd34 \u0648\u0632\u06cc\u0631 \u062c\u0646\u06af \u0622\u0645\u0631\u06cc\u06a9\u0627: \u0645\u0627 \u0622\u063a\u0627\u0632\u06af\u0631 \u062c\u0646\u06af \u0646\u0628\u0648\u062f\u06cc\u0645\u061b \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646 \u0647\u0631\u06af\u0632 \u0628\u0647 \u0633\u0644\u0627\u062d \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062f\u0633\u062a \u0646\u062e\u0648\u0627\u0647\u062f \u06cc\u0627\u0641\u062a",
          "link": "https://ir.voanews.com/a/8219967.html",
          "summary": "\u067e\u06cc\u062a \u0647\u06af\u0633\u062a\u060c \u0648\u0632\u06cc\u0631 \u062c\u0646\u06af \u0622\u0645\u0631\u06cc\u06a9\u0627\u060c \u0631\u0648\u0632 \u0633\u0647\u200c\u0634\u0646\u0628\u0647 \u06f1\u06f9 \u0622\u0628\u0627\u0646 \u062a\u0623\u06a9\u06cc\u062f \u06a9\u0631\u062f \u0627\u06cc\u0627\u0644\u0627\u062a \u0645\u062a\u062d\u062f\u0647 \u062a\u062d\u062a \u0647\u06cc\u0686 \u0634\u0631\u0627\u06cc\u0637\u06cc \u0627\u062c\u0627\u0632\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0647 \u0633\u0644\u0627\u062d \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062f\u0633\u062a \u06cc\u0627\u0628\u062f. \u0627\u0648 \u062f\u0631 \u062f\u0641\u0627\u0639 \u0627\u0632 \u0639\u0645\u0644\u06cc\u0627\u062a \u0646\u0638\u0627\u0645\u06cc \u0639\u0644\u06cc\u0647 \u0631\u0698\u06cc\u0645 \u0627\u06cc\u0631\u0627\u0646 \u06af\u0641\u062a: \u00ab\u0645\u0627 \u0627\u06cc\u0646 \u062c\u0646\u06af \u0631\u0627 \u0622\u063a\u0627\u0632 \u0646\u06a9\u0631\u062f\u06cc\u0645. \u0622\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
          "source_url": "https://ir.voanews.com/api/zbtpil-vomx-tpeqiyp"
        },
        {
          "title": "\ud83d\udd34  \u062f\u0648\u0646\u0627\u0644\u062f \u062a\u0631\u0627\u0645\u067e: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0647\u0631\u06af\u0632\u060c \u0647\u0631\u06af\u0632 \u0633\u0644\u0627\u062d \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a \u0648 \u0627\u0632 \u0627\u06cc\u0646 \u0628\u0627\u0628\u062a \u06a9\u0627\u0645\u0644\u0627\u064b \u0645\u0637\u0645\u0626\u0646 \u0628\u0627\u0634\u06cc\u062f\u061b \u06af\u0632\u0627\u0631\u0634\u200c\u0647\u0627 \u0627\u0632 \u0635\u062f\u0627\u06cc \u0627\u0646\u0641\u062c\u0627\u0631 \u062f\u0631 \u0642\u0634\u0645",
