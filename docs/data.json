          "title": "\u0628\u06cc\u200c\u0637\u0631\u0641\u06cc\u060c \u0631\u0627\u0633\u062a\u06cc\u200c\u0622\u0632\u0645\u0627\u06cc\u06cc \u0648 \u067e\u0627\u0633\u062e\u200c\u06af\u0648\u06cc\u06cc\u061b \u0686\u0631\u0627 \u0628\u06cc\u200c\u0628\u06cc\u200c\u0633\u06cc \u0641\u0627\u0631\u0633\u06cc \u0628\u0631 \u0627\u06cc\u0646 \u0627\u0635\u0648\u0644 \u0627\u06cc\u0633\u062a\u0627\u062f\u06af\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f\u061f",
