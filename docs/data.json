        {
          "title": "\u062a\u0631\u0627\u0645\u067e \u0627\u0632 \u0644\u063a\u0648 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a\u200c\u0647\u0627\u06cc \u0627\u0633\u062a\u0627\u0631\u0644\u06cc\u0646\u06a9 \u062e\u0628\u0631 \u062f\u0627\u062f \u0627\u0645\u0627 \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u0647\u0645\u0686\u0646\u0627\u0646 \u0628\u0631\u0642\u0631\u0627\u0631 \u0627\u0633\u062a",
