          "title": "\u06cc\u06a9 \u06a9\u0634\u062a\u0647 \u0648 \u06cc\u06a9 \u0632\u062e\u0645\u06cc \u062f\u0631 \u062d\u0645\u0644\u0647 \u00ab\u062a\u0631\u0648\u0631\u06cc\u0633\u062a\u06cc\u00bb \u062f\u0631 \u0627\u0645\u0627\u0646\u060c \u067e\u0627\u06cc\u062a\u062e\u062a \u0627\u0631\u062f\u0646",
