        {
          "title": "\u00ab\u0628\u0642\u0627\u06cc \u0627\u06cc\u0631\u0627\u0646\u00bb \u0648 \u00ab\u0639\u0647\u062f\u0646\u0627\u0645\u0647 \u062a\u0631\u06a9\u0645\u0646\u0686\u0627\u06cc\u00bb\u061b \u0645\u0648\u0627\u0641\u0642\u0627\u0646 \u0648 \u0645\u062e\u0627\u0644\u0641\u0627\u0646 \u00ab\u0639\u0642\u0628\u200c\u0646\u0634\u06cc\u0646\u06cc \u062a\u0627\u06a9\u062a\u06cc\u06a9\u06cc\u00bb \u0686\u0647 \u0645\u06cc\u200c\u06af\u0648\u06cc\u0646\u062f\u061f",
