          "title": "\u062a\u0631\u0627\u0645\u067e: \u062f\u0631 \u062c\u0646\u06af \u0628\u0627 \u0627\u06cc\u0631\u0627\u0646 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u0645 \u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u06cc\u0645 \u0628\u0647 \u067e\u06cc\u0631\u0648\u0632\u06cc \u06a9\u0627\u0645\u0644 \u062f\u0633\u062a \u0645\u06cc\u200c\u06cc\u0627\u0628\u06cc\u0645",
