          "title": "\ud83d\udd34 \u0628\u0633\u0646\u062a: \u062c\u0647\u0627\u0646 \u0627\u0632 \u0646\u0641\u062a \u0627\u06cc\u0631\u0627\u0646 \u0628\u06cc\u200c\u0646\u06cc\u0627\u0632 \u0627\u0633\u062a\u060c \u0627\u0645\u0627 \u062d\u06cc\u0627\u062a \u0627\u06cc\u0631\u0627\u0646 \u0628\u062f\u0648\u0646 \u0635\u0627\u062f\u0631\u0627\u062a \u0646\u0641\u062a \u0645\u0645\u06a9\u0646 \u0646\u06cc\u0633\u062a\u061b \u0645\u06cc\u0632\u0627\u0646 \u062a\u0631\u062f\u062f \u062f\u0631\u06cc\u0627\u06cc\u06cc \u062f\u0631 \u0647\u0631\u0645\u0632 \u0628\u0647 \u0633\u0637\u062d \u0642\u0628\u0644 \u0627\u0632 \u062f\u0631\u06af\u06cc\u0631\u06cc \u0628\u0627\u0632\u06af\u0634\u062a\u0647 \u0627\u0633\u062a",
