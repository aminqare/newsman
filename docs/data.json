          "title": "\ud83d\udd34\u062a\u0631\u0627\u0645\u067e: \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0627\u0632 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0627 \u062e\u0628\u0631 \u0627\u0633\u062a \u0648 \u0647\u0631 \u0686\u0647 \u0631\u0627 \u0645\u06cc\u200c\u06af\u0648\u06cc\u0646\u062f \u0645\u06cc\u200c\u0634\u0646\u0648\u062f\u061b \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648: \u062e\u0644\u0627\u0635 \u0634\u062f\u0646 \u0627\u0632 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062a\u0646\u0647\u0627 \u0631\u0627\u0647 \u0645\u0648\u062c\u0648\u062f \u0627\u0633\u062a",
          "link": "https://ir.voanews.com/a/8212243.html",
          "summary": "\u0631\u0626\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627 \u062f\u0631 \u06cc\u06a9 \u0633\u062e\u0646\u0631\u0627\u0646\u06cc \u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a\u06cc \u062f\u0631 \u062c\u0648\u0631\u062c\u06cc\u0627 \u06af\u0641\u062a \u0627\u06cc\u0627\u0644\u0627\u062a \u0645\u062a\u062d\u062f\u0647 \u0627\u0632 \u0647\u0645\u0647 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u0648 \u06af\u0641\u062a\u200c\u0648\u06af\u0648\u0647\u0627\u06cc \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0628\u0627\u062e\u0628\u0631 \u0627\u0633\u062a \u0648 \u0622\u0646\u0647\u0627 \u0631\u0627 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0647\u0645\u0632\u0645\u0627\u0646 \u0646\u062e\u0633\u062a\u200c\u0648\u0632\u06cc\u0631 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644 \u0628\u0647 \u0641\u0627\u06a9\u0633\u200c\u0646\u0628\u0648\u0632 \u06af\u0641\u062a \u062a\u0646\u0647\u0627 \u0631\u0627\u0647 \u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u00ab\u062e\u0644\u2026",
