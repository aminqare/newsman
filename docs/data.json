        {
          "title": "\u0633\u0646\u062f \u062a\u062d\u0648\u0644 \u0628\u0633\u06cc\u062c\u061b \u0628\u0631\u0646\u0627\u0645\u0647 \u06af\u0633\u062a\u0631\u0634 \u0627\u062e\u062a\u06cc\u0627\u0631\u0627\u062a \u0627\u06cc\u0646 \u0646\u0647\u0627\u062f \u062f\u0631 \u0627\u06cc\u0631\u0627\u0646 \u0686\u06cc\u0633\u062a\u061f",
