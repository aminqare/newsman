          "title": "\ud83d\udd34 \u062a\u0631\u0627\u0645\u067e: \u0627\u06cc\u0646\u06a9\u0647 \u062f\u0648\u0628\u0627\u0631\u0647 \u0628\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u062d\u0645\u0644\u0647 \u06a9\u0646\u06cc\u0645 \u06cc\u0627 \u0628\u0627 \u0622\u0646 \u062a\u0648\u0627\u0641\u0642 \u06a9\u0646\u06cc\u0645 \u0628\u0647 \u0631\u0698\u06cc\u0645 \u0628\u0633\u062a\u06af\u06cc \u062f\u0627\u0631\u062f\u061b \u0645\u0634\u06a9\u0644 \u0627\u06cc\u0646 \u0627\u0633\u062a \u06a9\u0647 \u0622\u06cc\u0627 \u0628\u0647 \u062a\u0648\u0627\u0641\u0642 \u067e\u0627\u06cc\u0628\u0646\u062f \u062e\u0648\u0627\u0647\u0646\u062f \u0645\u0627\u0646\u062f\u061f",
