        {
          "title": "\ud83d\udd34 \u0641\u0646\u0644\u0627\u0646\u062f: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0646\u0628\u0627\u06cc\u062f \u0628\u0645\u0628 \u0647\u0633\u062a\u0647\u200c\u0627\u06cc\u060c \u0645\u0648\u0634\u06a9\u060c \u0646\u06cc\u0627\u0628\u062a\u06cc \u0648 \u06a9\u0646\u062a\u0631\u0644 \u0647\u0631\u0645\u0632 \u0631\u0627 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f\u061b \u062a\u0648\u0646\u06cc \u0628\u0644\u0631: \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0639\u0632\u0645 \u062a\u0631\u0627\u0645\u067e \u0631\u0627 \u062f\u0633\u062a\u200c\u06a9\u0645 \u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a",
          "link": "https://ir.voanews.com/a/iran-us-related-live-news-coverage/8162914.html",
          "summary": "\u0631\u0626\u06cc\u0633\u200c\u062c\u0645\u0647\u0648\u0631 \u0641\u0646\u0644\u0627\u0646\u062f \u06af\u0641\u062a \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0646\u0628\u0627\u06cc\u062f \u0628\u0647 \u0633\u0644\u0627\u062d \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u062f\u0633\u062a \u06cc\u0627\u0628\u062f\u060c \u0627\u0632 \u0646\u06cc\u0631\u0648\u0647\u0627\u06cc \u0646\u06cc\u0627\u0628\u062a\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u062f\u060c \u062a\u0648\u0627\u0646 \u062a\u0648\u0644\u06cc\u062f \u0645\u0648\u0634\u06a9 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f \u06cc\u0627 \u062a\u0646\u06af\u0647 \u0647\u0631\u0645\u0632 \u0631\u0627 \u0628\u0628\u0646\u062f\u062f. \u0647\u0645\u0632\u0645\u0627\u0646 \u0646\u062e\u0633\u062a\u200c\u0648\u0632\u06cc\u0631 \u067e\u06cc\u0634\u06cc\u0646 \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u0647\u0645 \u0647\u0634\u062f\u0627\u0631 \u062f\u0627\u062f \u06a9\u0647 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0639\u0632\u0645 \u0631\u0626\u06cc\u0633\u2026",
          "source": "\u062e\u0628\u0631 \u0627\u0648\u0644 - \u0635\u062f\u0627\u06cc \u0622\u0645\u0631\u06cc\u06a9\u0627",
