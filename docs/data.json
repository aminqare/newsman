        {
          "title": "\u0647\u0645\u200c\u0632\u0645\u0627\u0646 \u0628\u0627 \u06af\u0645\u0627\u0646\u0647\u200c\u0632\u0646\u06cc \u062f\u0631\u0628\u0627\u0631\u0647 \u062d\u0645\u0644\u0627\u062a \u062a\u0627\u0632\u0647\u061b \u0622\u0644\u0648\u062f\u06af\u06cc \u0646\u0641\u062a\u06cc \u062e\u0644\u06cc\u062c \u0641\u0627\u0631\u0633 \u0686\u0647\u0627\u0631 \u0628\u0631\u0627\u0628\u0631 \u0634\u062f",
