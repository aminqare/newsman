        {
          "title": "\u0647\u0645\u0631\u0627\u0647 \u062f\u0627\u0634\u062a\u0646 \u0645\u0648\u0628\u0627\u06cc\u0644 \u062f\u0631 \u0645\u062f\u0631\u0633\u0647 \u062f\u0631 \u0627\u0646\u06af\u0644\u0633\u062a\u0627\u0646 \u0645\u0645\u0646\u0648\u0639 \u0634\u062f",
