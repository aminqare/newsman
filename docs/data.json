        {
          "title": "\u0627\u0632 \u062c\u0641\u0631 \u0648 \u0631\u0645\u0644 \u062e\u0627\u0645\u0646\u0647\u200c\u0627\u06cc \u062a\u0627 \u0627\u0646\u06af\u0634\u062a\u0631 \u0628\u0627\u0637\u0644\u200c\u0627\u0644\u0633\u062d\u0631 \u0648\u0632\u06cc\u0631 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u061b \u062c\u0627\u06cc\u06af\u0627\u0647 \u0639\u0644\u0648\u0645 \u063a\u0631\u06cc\u0628\u0647 \u062f\u0631 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc",
