        {
          "title": "\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0686\u0647 \u062a\u0627\u062b\u06cc\u0631\u06cc \u0628\u0631 \u0622\u06cc\u0646\u062f\u0647 \u0627\u06cc\u0631\u0627\u0646 \u062f\u0627\u0631\u062f\u061f \u0648\u0627\u06a9\u0646\u0634\u200c\u0647\u0627\u06cc \u0645\u062a\u0641\u0627\u0648\u062a \u062f\u0631 \u0634\u0628\u06a9\u0647\u200c\u0647\u0627\u06cc \u0627\u062c\u062a\u0645\u0627\u0639\u06cc",
