          "title": "\u0641\u0631\u0645\u0627\u0646\u062f\u0647 \u0646\u06cc\u0631\u0648\u06cc \u062f\u0631\u06cc\u0627\u06cc\u06cc \u0627\u0631\u062a\u0634 \u0627\u06cc\u0631\u0627\u0646 \u0645\u06cc\u200c\u06af\u0648\u06cc\u062f \u06a9\u0647 \u0639\u0645\u0644\u06cc\u0627\u062a\u06cc \u0628\u0631\u0627\u06cc \u0634\u06a9\u0633\u062a\u0646 \u0645\u062d\u0627\u0635\u0631\u0647 \u062f\u0631 \u067e\u06cc\u0634 \u0627\u0633\u062a",
