        {
          "title": "\u062d\u0645\u0644\u0647 \u067e\u0647\u067e\u0627\u062f\u06cc \u00ab\u0628\u06cc\u200c\u0633\u0627\u0628\u0642\u0647\u00bb \u0627\u0648\u06a9\u0631\u0627\u06cc\u0646 \u0628\u0647 \u0631\u0648\u0633\u06cc\u0647\u060c \u067e\u0627\u0644\u0627\u06cc\u0634\u06af\u0627\u0647 \u0646\u0641\u062a \u0645\u0633\u06a9\u0648 \u0647\u062f\u0641 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a",
