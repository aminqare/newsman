        {
          "title": "\u0627\u0646\u062a\u062e\u0627\u0628\u0627\u062a \u0628\u0631\u0632\u06cc\u0644 \u0628\u0647 \u062f\u0648\u0631 \u062f\u0648\u0645 \u06a9\u0634\u06cc\u062f\u0647 \u0634\u062f\u060c \u0628\u0648\u0644\u0633\u0648\u0646\u0627\u0631\u0648 \u0628\u0627 \u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0646\u062f\u06a9 \u0628\u0631\u0646\u062f\u0647 \u062f\u0648\u0631 \u0646\u062e\u0633\u062a \u0634\u062f",
