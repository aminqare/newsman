          "summary": "\u0648\u0632\u06cc\u0631 \u062e\u0627\u0631\u062c\u0647 \u0641\u0631\u0627\u0646\u0633\u0647 \u0633\u067e\u0627\u0647 \u067e\u0627\u0633\u062f\u0627\u0631\u0627\u0646 \u0631\u0627 \u0628\u0647 \u062f\u0633\u062a \u062f\u0627\u0634\u062a\u0646 \u062f\u0631 \u062d\u0645\u0644\u0647 \u0633\u0627\u06cc\u0628\u0631\u06cc \u0628\u0647 \u06cc\u062e\u0686\u0627\u0644 \u0641\u0631\u0648\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u0627\u0646\u0633\u0648\u06cc \u0645\u062a\u0647\u0645 \u06a9\u0631\u062f. \u0698\u0627\u0646 \u0646\u0648\u0626\u0644 \u0628\u0627\u0631\u0648 \u0648\u0639\u062f\u0647 \u062f\u0627\u062f \u06a9\u0647 \u062f\u0631 \u0648\u0627\u06a9\u0646\u0634 \u0628\u0647 \u0627\u06cc\u0646 \u062d\u0645\u0644\u0647 \u0633\u0627\u06cc\u0628\u0631\u06cc \u062a\u062d\u0631\u06cc\u0645\u200c\u0647\u0627\u06cc\u06cc \u00ab\u062f\u0631 \u0633\u0637\u062d \u0627\u0631\u0648\u067e\u0627\u06cc\u06cc\u00bb \u0639\u0644\u06cc\u0647 \u0627\u06cc\u0631\u0627\u0646 \u0648\u0636\u0639 \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u0627\u06cc\u0631\u0627\u0646 \u062a\u0627\u06a9\u0646\u2026",
