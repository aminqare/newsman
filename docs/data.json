          "title": "\ud83d\udd34 \u0631\u0648\u0628\u06cc\u0648: \u062c\u0646\u06af \u0628\u0627 \u062c\u0645\u0647\u0648\u0631\u06cc \u0627\u0633\u0644\u0627\u0645\u06cc \u0627\u0632 \u062c\u0647\u0627\u062a\u06cc \u062a\u0645\u0627\u0645 \u0634\u062f\u0647 \u0627\u0633\u062a\u061b \u0647\u0634\u062f\u0627\u0631 \u0646\u062a\u0627\u0646\u06cc\u0627\u0647\u0648 \u0628\u0647 \u062f\u0634\u0645\u0646\u0627\u0646 \u0627\u0633\u0631\u0627\u0626\u06cc\u0644: \u00ab\u0639\u0632\u0645 \u0645\u0627 \u0631\u0627 \u0622\u0632\u0645\u0627\u06cc\u0634 \u0646\u06a9\u0646\u06cc\u062f\u00bb",
