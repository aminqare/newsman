        {
          "title": "\u0627\u0639\u062a\u0631\u0627\u0636\u200c\u0647\u0627\u06cc \u062e\u06cc\u0627\u0628\u0627\u0646\u06cc \u0648 \u0628\u062d\u0631\u0627\u0646 \u0628\u062f\u0647\u06cc\u061b \u0622\u06cc\u0627 \u0641\u0631\u0627\u0646\u0633\u0647 \u0628\u0647 \u0633\u0645\u062a \u0637\u0648\u0641\u0627\u0646 \u0645\u0627\u0644\u06cc \u0645\u06cc\u200c\u0631\u0648\u062f\u061f",
