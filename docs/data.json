          "title": "\u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u06cc \u0647\u0631\u0645\u0632\u06af\u0627\u0646: \u062f\u0648 \u0642\u0627\u06cc\u0642 \u0635\u06cc\u0627\u062f\u06cc \u062f\u0631 \u0622\u0628\u200c\u0647\u0627\u06cc \u0642\u0634\u0645 \u0647\u062f\u0641 \u062d\u0645\u0644\u0647 \u0622\u0645\u0631\u06cc\u06a9\u0627 \u0642\u0631\u0627\u0631 \u06af\u0631\u0641\u062a\u0646\u062f",
