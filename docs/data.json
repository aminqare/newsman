        {
          "title": "\u067e\u06cc\u0631\u0648\u0632\u06cc \u062a\u0627\u0631\u06cc\u062e\u06cc \u0628\u0631\u0627\u06cc \u062f\u0645\u0648\u06a9\u0631\u0627\u062a\u200c\u0647\u0627\u061b \u0627\u0648\u0644\u06cc\u0646 \u0633\u0646\u0627\u062a\u0648\u0631 \u0633\u06cc\u0627\u0647\u067e\u0648\u0633\u062a \u062f\u0631 \u0645\u06cc\u200c\u0633\u06cc\u200c\u0633\u06cc\u200c\u067e\u06cc \u0628\u0639\u062f \u0627\u0632 \u06f1\u06f4\u06f0 \u0633\u0627\u0644",
