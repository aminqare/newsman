          "title": "\u0631\u0636\u0627\u06cc\u06cc \u0628\u0631\u0627\u06cc \u00ab\u0627\u0646\u062a\u0642\u0627\u0644 \u067e\u06cc\u0627\u0645 \u0645\u062c\u062a\u0628\u06cc \u062e\u0627\u0645\u0646\u0647\u200c\u0627\u06cc\u00bb \u062f\u0631 \u06a9\u0631\u0645\u0644\u06cc\u0646 \u0628\u0627 \u067e\u0648\u062a\u06cc\u0646 \u062f\u06cc\u062f\u0627\u0631 \u06a9\u0631\u062f",
