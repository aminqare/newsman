          "title": "\u0622\u0645\u0631\u06cc\u06a9\u0627 \u062a\u0645\u0627\u0645\u06cc \u0628\u0645\u0628\u200c\u0627\u0641\u06a9\u0646\u200c\u0647\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u0627\u0632 \u067e\u0627\u06cc\u06af\u0627\u0647 \u0641\u0631\u0641\u0648\u0631\u062f \u0628\u0631\u06cc\u062a\u0627\u0646\u06cc\u0627 \u062e\u0627\u0631\u062c \u06a9\u0631\u062f",
