          "title": "\u067e\u0633 \u0627\u0632 \u062a\u0631\u06a9\u06cc\u0647\u060c \u0639\u0631\u0627\u0642 \u0648 \u06af\u0631\u062c\u0633\u062a\u0627\u0646 \u0646\u06cc\u0632 \u0648\u0631\u0648\u062f \u0647\u0648\u0627\u067e\u06cc\u0645\u0627\u0647\u0627\u06cc \u0627\u06cc\u0631\u0627\u0646\u06cc \u0631\u0627 \u0645\u0645\u0646\u0648\u0639 \u06a9\u0631\u062f\u0646\u062f",
