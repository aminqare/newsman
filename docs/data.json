        {
          "title": "\u0628\u0628\u06cc\u0646\u06cc\u062f: \u067e\u06cc\u062a \u0647\u06af\u0633\u062a \u0648 \u0647\u0645\u0631\u0627\u0647\u0627\u0646\u0634 \u0627\u0632 \u06af\u0627\u0631\u062f \u0648\u06cc\u0698\u0647 \u0645\u0642\u0628\u0631\u0647 \u0633\u0631\u0628\u0627\u0632\u0627\u0646 \u06af\u0645\u0646\u0627\u0645 \u062a\u0630\u06a9\u0631 \u062f\u0631\u06cc\u0627\u0641\u062a \u06a9\u0631\u062f\u0646\u062f",
